end)

define("df", "df", function(_, io)
io.out(string.format("%-12s %10s %10s %10s\n", "Mounted on", "Size", "Used", "Avail"))
local rows = {{"/", ctx.root}}
if ctx.tmp then rows[#rows + 1] = {"/tmp", ctx.tmp} end
local names = {}
for name in pairs(mounts()) do names[#names + 1] = name end
table.sort(names)
local m = mounts()
for _, name in ipairs(names) do rows[#rows + 1] = {"/mnt/" .. name, m[name]} end
for _, r in ipairs(rows) do
local total = ctx.invoke(r[2], "spaceTotal") or 0
local used = ctx.invoke(r[2], "spaceUsed") or 0
if total == math.huge then total = used end
io.out(string.format("%-12s %9dK %9dK %9dK\n", r[1], total // 1024, used // 1024, (total - used) // 1024))
end
end)

define("du", "du [-s] [path...]", function(args, io)
local opts, paths = options(args, "s")
if not opts then io.err("du: " .. paths .. "\n") return 2 end
if #paths == 0 then paths = {"."} end
local function walk(path, shown, report)
local total = 0
if fs.isDir(path) then
for _, n in ipairs(fs.list(path) or {}) do
local name = n:gsub("/$", "")
total = total + walk(path .. (path == "/" and "" or "/") .. name, shown .. "/" .. name, report and not opts.s)
end
else
total = fs.size(path)
end
if report and fs.isDir(path) then io.out(string.format("%d\t%s\n", (total + 1023) // 1024, shown)) end
return total
end
for _, p in ipairs(paths) do
local path = absolute(p)
local total = walk(path, p, not opts.s)
if opts.s or not fs.isDir(path) then io.out(string.format("%d\t%s\n", (total + 1023) // 1024, p)) end
end
end)

define("clear", "clear", function() ctx.clear() end)

define("help", "help", function(_, io)
io.out("shell commands (POSIX-style; | > >> < 2> ; && || & quotes $VAR * ? work):\n")
local sorted = {}
for _, u in ipairs(help) do sorted[#sorted + 1] = u end
table.sort(sorted)
for _, u in ipairs(sorted) do io.out("  " .. u .. "\n") end
io.out("plus programs in $PATH, and:\n")
if ctx.help then ctx.help() end
end)




local function argv(words)
local out = {}
for _, w in ipairs(words) do
local text = wordText(w)
if w.glob then
for _, p in ipairs(expandGlob(text)) do out[#out + 1] = p end
else
out[#out + 1] = text
end
end
return out
end

local function runPipeline(pipeline)
local input, status = nil, 0
for i, cmd in ipairs(pipeline.commands) do
local args = argv(cmd.words)

local assigned = {}
while args[1] and args[1]:match("^[%a_][%w_]*=") do
local k, v = table.remove(args, 1):match("^([%a_][%w_]*)=(.*)$")
assigned[k] = v
end
local errOut = {}
if cmd.stdin then
local text, err = fs.read(absolute(wordText(cmd.stdin)))
if not text then ctx.write("sh: " .. err .. "\n") return 1 end
input = text
end
local captured = i < #pipeline.commands or cmd.stdout ~= nil
local outBuf = {}
local io = {stdin = input, captured = captured}
io.out = function(text)
if captured then outBuf[#outBuf + 1] = text else ctx.write(text) end
end
io.err = function(text)
if cmd.stderrToOut then io.out(text)
elseif cmd.stderr then errOut[#errOut + 1] = text
else ctx.write(text) end
end
if #args == 0 then
for k, v in pairs(assigned) do env[k] = v end
status = 0
elseif builtins[args[1]] then
local name = table.remove(args, 1)
local ok, result = pcall(builtins[name], args, io)
if ok then
status = tonumber(result) or 0
else
io.err(name .. ": " .. tostring(result) .. "\n")
status = 1
end
else
if captured or input then
ctx.write("sh: " .. args[1] .. ": a program's output goes to the console, so it can't be piped or redirected\n")
end
status = ctx.external(args, pipeline.background)
end
if cmd.stderr then
local ok, err = fs.write(absolute(wordText(cmd.stderr.word)), table.concat(errOut), cmd.stderr.append)
if not ok then ctx.write("sh: " .. err .. "\n") end
end
local output = table.concat(outBuf)
if cmd.stdout then
local ok, err = fs.write(absolute(wordText(cmd.stdout.word)), output, cmd.stdout.append)
if not ok then ctx.write("sh: " .. err .. "\n") status = 1 end
input = nil
else
input = output
end
end
return status
end


function M.run(line)
local tokens, err = tokenize(line)
local list
if tokens then list, err = parse(tokens) end
if not list then
ctx.write("sh: " .. err .. "\n")
lastStatus = 2
return 2
end
local status, skip = lastStatus, nil
for _, pipeline in ipairs(list) do
if not skip then status = runPipeline(pipeline) end
lastStatus = status

if pipeline.join == "&&" then
skip = status ~= 0 and true or nil
elseif pipeline.join == "||" then
skip = status == 0 and true or nil
else
skip = nil
end
end
return status
end

M.isBuiltin = function(name) return builtins[name] ~= nil end
M.cwd = function() return env.PWD end
M.env = env


if not fs.isDir(env.HOME) then fs.mkdir(env.HOME) end
if fs.isDir(env.HOME) then env.PWD = env.HOME end

return M

@@ 2663 /bitmap.lua








































local M = {}

local function getPixel(pixels, x, y, width, height)
if x < 1 or x > width or y < 1 or y > height then return nil end
local row = pixels[y]
return row and row[x] or nil
end


local function encodeHalfBlock(pixels, width, height, bg)
local cols = width
local rows = math.ceil(height / 2)
local upperHalf = utf8.char(0x2580)
local lowerHalf = utf8.char(0x2584)
local cells = {}
for row = 1, rows do
cells[row] = {}
for col = 1, cols do
local top = getPixel(pixels, col, row * 2 - 1, width, height)
local bottom = getPixel(pixels, col, row * 2, width, height)
local fg, cellBg, char
if not top and not bottom then
fg, cellBg, char = bg, bg, " "
elseif top and bottom and top == bottom then
fg, cellBg, char = top, top, " "
elseif top and not bottom then
fg, cellBg, char = top, bg, upperHalf
elseif bottom and not top then
fg, cellBg, char = bottom, bg, lowerHalf
else
fg, cellBg, char = top, bottom, upperHalf
end
cells[row][col] = {char = char, fg = fg, bg = cellBg}
end
end
return cells, cols, rows
end






local DOT_BITS = {
{1, 1, 0x01}, {1, 2, 0x02}, {1, 3, 0x04}, {1, 4, 0x40},
{2, 1, 0x08}, {2, 2, 0x10}, {2, 3, 0x20}, {2, 4, 0x80},
}





local function encodeBraille(pixels, width, height, bg)
local cols = math.ceil(width / 2)
local rows = math.ceil(height / 4)
local cells = {}
for row = 1, rows do
cells[row] = {}
for col = 1, cols do
local bits = 0
local fg = nil
for _, d in ipairs(DOT_BITS) do
local dx, dy, bit = d[1], d[2], d[3]
local px = getPixel(pixels, (col - 1) * 2 + dx, (row - 1) * 4 + dy, width, height)
if px then
bits = bits | bit
if not fg then fg = px end
end
end
local char = bits == 0 and " " or utf8.char(0x2800 + bits)
cells[row][col] = {char = char, fg = fg or bg, bg = bg}
end
end
return cells, cols, rows
end





function M.encode(mode, pixels, width, height, bg)
bg = bg or 0x000000
if mode == "braille" then
return encodeBraille(pixels, width, height, bg)
end
return encodeHalfBlock(pixels, width, height, bg)
end







function M.draw(gpu, cells, rows, cols, originX, originY)
local curFg, curBg
for row = 1, rows do
local rowCells = cells[row]
local col = 1
while col <= cols do
local cell = rowCells[col]
local fg, bg = cell.fg, cell.bg
local chars = {cell.char}
local runEnd = col
while runEnd + 1 <= cols and rowCells[runEnd + 1].fg == fg and rowCells[runEnd + 1].bg == bg do
runEnd = runEnd + 1
chars[#chars + 1] = rowCells[runEnd].char
end
if fg ~= curFg then gpu.setForeground(fg); curFg = fg end
if bg ~= curBg then gpu.setBackground(bg); curBg = bg end
gpu.set(originX + col - 1, originY + row - 1, table.concat(chars))
col = runEnd + 1
end
end
end

return M

@@ 3046 /lineedit.lua

















local KEY = {LEFT = 0xCB, RIGHT = 0xCD, UP = 0xC8, DOWN = 0xD0, HOME = 0xC7, END = 0xCF,
BACK = 0x0E, DELETE = 0xD3, ENTER = 0x1C}
local CTRL = {A = 1, E = 5, K = 11, U = 21, W = 23}
local HISTORY_MAX = 100

local function chars(text)
local out = {}
if utf8.len(text) then
for _, c in utf8.codes(text) do out[#out + 1] = utf8.char(c) end
else
for i = 1, #text do out[i] = text:sub(i, i) end
end
return out
end

local Editor = {}
Editor.__index = Editor


function Editor:text() return table.concat(self.line) end


function Editor:cursor() return self.pos end

function Editor:set(text)
self.line = chars(text)
self.pos = #self.line
end


function Editor:insert(text)
for _, c in ipairs(chars(text)) do
table.insert(self.line, self.pos + 1, c)
self.pos = self.pos + 1
end
end

local function cut(self, from, to)
for _ = from, to do table.remove(self.line, from) end
if self.pos >= to then
self.pos = self.pos - (to - from + 1)
elseif self.pos >= from then
self.pos = from - 1
end
end

local function recall(self, index)
if index == #self.history + 1 then
self:set(self.draft or "")
self.draft = nil
else
if self.browse == #self.history + 1 then self.draft = self:text() end
self:set(self.history[index])
end
self.browse = index
end




function Editor:key(char, code)
local n = #self.line
if code == KEY.ENTER then
local line = self:text()
if line:find("%S") and self.history[#self.history] ~= line then
self.history[#self.history + 1] = line
if #self.history > HISTORY_MAX then table.remove(self.history, 1) end
end
self.line, self.pos, self.draft = {}, 0, nil
self.browse = #self.history + 1
return line
elseif code == KEY.LEFT then
if self.pos == 0 then return nil end
self.pos = self.pos - 1
elseif code == KEY.RIGHT then
if self.pos == n then return nil end
self.pos = self.pos + 1
elseif code == KEY.HOME or char == CTRL.A then
self.pos = 0
elseif code == KEY.END or char == CTRL.E then
self.pos = n
elseif code == KEY.UP then
if self.browse <= 1 then return nil end
recall(self, self.browse - 1)
elseif code == KEY.DOWN then
if self.browse > #self.history then return nil end
recall(self, self.browse + 1)
elseif code == KEY.BACK then
if self.pos == 0 then return nil end
cut(self, self.pos, self.pos)
elseif code == KEY.DELETE then
if self.pos == n then return nil end
cut(self, self.pos + 1, self.pos + 1)
elseif char == CTRL.U then
if self.pos == 0 then return nil end
cut(self, 1, self.pos)
elseif char == CTRL.K then
if self.pos == n then return nil end
cut(self, self.pos + 1, n)
elseif char == CTRL.W then
local from = self.pos
while from > 0 and self.line[from]:find("^%s$") do from = from - 1 end
while from > 0 and not self.line[from]:find("^%s$") do from = from - 1 end
if from == self.pos then return nil end
cut(self, from + 1, self.pos)
elseif char and char >= 32 then
local ok, c = pcall(utf8.char, char)
if not ok then return nil end
self:insert(c)
else
return nil
end
return true
end

return {
new = function()
return setmetatable({line = {}, pos = 0, history = {}, browse = 1}, Editor)
end,
KEY = KEY,
}

@@ 6021 /system.lua














local disk = ...

local M = {}

local CONFIG, USERS = "/etc/kernal.cfg", "/etc/users"



local FLAGS = {
{name = "login_required", type = "boolean", default = true, reboot = true,
help = "the console asks for a user name at boot (false: logged in as root)"},
{name = "update_requires_root", type = "boolean", default = true,
help = "only root can update the kernal and its modules"},
{name = "reboot_requires_root", type = "boolean", default = false,
help = "only root can reboot or shut down"},
{name = "drain_requires_root", type = "boolean", default = false,
help = "only root can drain, undrain or migrate"},
{name = "useradd_requires_root", type = "boolean", default = true,
help = "only root can add or remove users"},
{name = "kill_requires_owner", type = "boolean", default = false,
help = "only a process's own user (or root) can pause, resume or kill it"},
{name = "logout_ends_jobs", type = "boolean", default = true,
help = "logging out ends the applications started from that login, except persistent ones"},
{name = "scheduler", type = "choice", choices = {"load", "count"}, default = "load",
help = "where new work goes: the worker with the lowest load average, or the fewest processes"},
{name = "remote_terminals", type = "boolean", default = true, reboot = true,
help = "network terminals (muxterm) can log in"},
{name = "terminal_port", type = "number", default = 4478, min = 1, max = 65535, reboot = true,
not_ = 4477, help = "the network port terminals use (not 4477, the cluster's)"},
}
local byName = {}
for _, f in ipairs(FLAGS) do byName[f.name] = f end
M.FLAGS = FLAGS

local values = {}


local function parse(flag, text)
text = text:match("^%s*(.-)%s*$")
if flag.type == "boolean" then
if text == "true" or text == "yes" or text == "on" then return true end
if text == "false" or text == "no" or text == "off" then return false end
return nil, flag.name .. " is true or false, not \"" .. text .. "\""
elseif flag.type == "number" then
local n = math.tointeger(tonumber(text))
if not n or (flag.min and n < flag.min) or (flag.max and n > flag.max) or n == flag.not_ then
return nil, flag.name .. " is a whole number" .. (flag.min and (" from " .. flag.min .. " to " .. flag.max) or "")
.. (flag.not_ and (" other than " .. flag.not_) or "") .. ", not \"" .. text .. "\""
end
return n
elseif flag.choices then
for _, c in ipairs(flag.choices) do if c == text then return text end end
return nil, flag.name .. " is one of " .. table.concat(flag.choices, ", ") .. ", not \"" .. text .. "\""
end
return text
end


function M.loadFlags()
values = {}
local problems = {}
local text = disk.read(CONFIG)
if not text then return problems end
local n = 0
for line in (text .. "\n"):gmatch("([^\n]*)\n") do
n = n + 1
local body = line:gsub("#.*", ""):match("^%s*(.-)%s*$")
if body ~= "" then
local name, value = body:match("^([%w_]+)%s*=%s*(.-)$")
local flag = name and byName[name]
if not name then
problems[#problems + 1] = CONFIG .. ":" .. n .. ": not `name = value`: " .. line
elseif not flag then
problems[#problems + 1] = CONFIG .. ":" .. n .. ": no flag called " .. name
else
local v, why = parse(flag, value)
if v == nil then
problems[#problems + 1] = CONFIG .. ":" .. n .. ": " .. why .. " -- using " .. tostring(flag.default)
else
values[name] = v
end
end
end
end
return problems
end

function M.flag(name)
local flag = assert(byName[name], "no flag called " .. tostring(name))
if values[name] == nil then return flag.default end
return values[name]
end



function M.setFlag(name, text)
local flag = byName[name]
if not flag then return nil, "no flag called " .. tostring(name) .. " (`flags` lists them)" end
local v, why = parse(flag, text)
if v == nil then return nil, why end
local lines, done = {}, false
local old = disk.read(CONFIG) or ""
for line in old:gmatch("[^\n]+") do
if line:match("^%s*([%w_]+)%s*=") == name then
if not done then lines[#lines + 1] = name .. " = " .. tostring(v) done = true end
else
lines[#lines + 1] = line
end
end
if not done then lines[#lines + 1] = name .. " = " .. tostring(v) end
disk.mkdir("/etc")
local ok, err = disk.write(CONFIG, table.concat(lines, "\n") .. "\n")
if not ok then return nil, "can't write " .. CONFIG .. ": " .. tostring(err) end
values[name] = v
return flag
end



function M.allowed(user, flagName, doing)
if user == "root" or not M.flag(flagName) then return true end
return nil, doing .. ": only root can do that (flag " .. flagName .. "); log in as root"
end



local VALID = "^[a-z_][a-z0-9_%-]*$"

function M.users()
local list, seen = {"root"}, {root = true}
for line in (disk.read(USERS) or ""):gmatch("[^\n]+") do
local name = line:gsub("#.*", ""):match("^%s*(%S+)")
if name and name:match(VALID) and not seen[name] then
list[#list + 1] = name
seen[name] = true
end
end
return list
end

function M.userExists(name)
for _, u in ipairs(M.users()) do if u == name then return true end end
return false
end

function M.home(name)
return name == "root" and "/root" or "/home/" .. name
end

function M.addUser(name)
if type(name) ~= "string" or not name:match(VALID) or #name > 32 then
return nil, "a user name is lowercase letters, digits, _ and -, up to 32, starting with a letter or _"
end
if M.userExists(name) then return nil, name .. " already exists" end
local list = M.users()
list[#list + 1] = name
table.remove(list, 1)
disk.mkdir("/etc")
local ok, err = disk.write(USERS, table.concat(list, "\n") .. "\n")
if not ok then return nil, "can't write " .. USERS .. ": " .. tostring(err) end
disk.mkdir(M.home(name))
return true
end


function M.removeUser(name)
if name == "root" then return nil, "root can't be removed" end
if not M.userExists(name) then return nil, "no such user: " .. tostring(name) end
local list = {}
for _, u in ipairs(M.users()) do if u ~= name and u ~= "root" then list[#list + 1] = u end end
local ok, err = disk.write(USERS, #list > 0 and table.concat(list, "\n") .. "\n" or "")
if not ok then return nil, "can't write " .. USERS .. ": " .. tostring(err) end
return true
end

return M

