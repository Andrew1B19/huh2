local K, deps = ...
local system = K.system

local T = {byAddress = {}}
local PORT = system.flag("terminal_port")
T.PORT = PORT
local SILENT, QUIET = 10, 2
local MAX_READ = 1024 * 1024
local FILES = {"terminal.lua", "session.lua", "compositor.lua", "bitmap.lua", "lineedit.lua", "vgpu.lua"}

if system.flag("remote_terminals") then deps.modem.open(PORT) end

local function sendTo(address, msg)
msg.from, msg.to = K.selfAddr, address
deps.send(msg, PORT)
end

local function newKey()
return string.format("%04x%04x%04x", math.random(0, 0xFFFF), math.random(0, 0xFFFF), math.random(0, 0xFFFF))
end


local function newProxy(address, info)
local now = computer.uptime()
local P = {kind = "terminal", address = address, width = tonumber(info.console) or 80,
screen = {tonumber(info.width) or 80, tonumber(info.height) or 25}, lastSeen = now, lastSent = now}
P.display = {
address = address, port = PORT,
create = function(spec)
local w, h = math.tointeger(tonumber(spec.width)) or 30, math.tointeger(tonumber(spec.height)) or 10
sendTo(address, {type = "TWINDOW", spec = {id = spec.id, title = spec.title, x = spec.x, y = spec.y,
width = w, height = h, resizable = spec.resizable, decorated = spec.decorated, ownerJobId = spec.ownerJobId,
ownerNode = spec.ownerNode, key = spec.key, code = spec.code, args = spec.args, cells = spec.cells, bg = spec.bg,
persist = spec.persist}})
return {width = w, height = h}
end,
remove = function(id) sendTo(address, {type = "TWINREMOVE", window = id}) end,
status = function(id, status) sendTo(address, {type = "TWINSTATUS", window = id, status = status}) end,
persist = function(id, on) sendTo(address, {type = "TWINPERSIST", window = id, on = on}) end,
setOwner = function(id, jobId, node) sendTo(address, {type = "TOWNER", window = id, job = jobId, node = node}) end,
share = function(id, jobId, rect, node) sendTo(address, {type = "TSHARE", window = id, job = jobId, rect = rect, node = node}) end,
}
P.width, P.height = P.screen[1], P.screen[2]
P.consoleColumns = tonumber(info.console) or 80
function P.write(text) sendTo(address, {type = "TOUT", text = tostring(text)}) P.lastSent = computer.uptime() end
function P.print(...)
local parts = {}
for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
P.write(table.concat(parts, "\t") .. "\n")
end
function P.command() return false end
function P.deny(flagName, doing)
local ok, why = system.allowed(P.user, flagName, doing)
if not ok then P.print(why) return true end
end
function P.shellRun(line)
if P.shell then P.shell.run(line) else P.print("no shell -- run `update` with the installer floppy in") end
end
function P.cwd() return P.shell and P.shell.cwd() or (P.user and system.home(P.user)) or "/" end
function P.beginForeground(id)
P.foregroundJob = id
local job = K.jobs[id]
sendTo(address, {type = "TFG", job = id, node = job and job.node})
end
function P.endForeground()
P.foregroundJob = nil
sendTo(address, {type = "TFG"})
end
function P.consoleWidth() return P.consoleColumns end
function P.clearConsole() sendTo(address, {type = "TCLEAR"}) end
function P.windowsChanged()
if P.user then sendTo(address, {type = "TUSERWINDOWS", list = K.win.ofUser(P.user)}) end
end
function P.update() end
function P.input() end
function P.redraw() end


function P.resume()
if not P.co then return end
local ok, err = K.resumeCommand(P, P.co)
if coroutine.status(P.co) == "dead" then
local id = P.cmdId
P.co, P.cmdId = nil, nil
if not ok then P.print("command error: " .. tostring(err)) end
sendTo(address, {type = "RESULT", id = id, result = {cwd = P.cwd()}})
end
end
function P.logout()
K.endLogin(P)
P.user, P.shell, P.login = nil, nil, nil
end
return P
end

local function reply(P, msg, result, err)
if not msg.id then return end
if result == nil then
sendTo(P.address, {type = "ERROR", id = msg.id, error = err})
else
sendTo(P.address, {type = "RESULT", id = msg.id, result = result})
end
end

local function hangUp(P, why)
T.byAddress[P.address] = nil
K.endSession(P)
sendTo(P.address, {type = "TBYE", why = why})
end


local handlers = {}
function handlers.TLOGIN(P, msg)
local name = tostring(msg.name)
if not system.userExists(name) then return reply(P, msg, nil, "no such user: " .. name) end
if P.user then K.endLogin(P) end
P.user, P.login = name, K.nextLogin()
P.shell = K.newShell(P, name)
reply(P, msg, {login = P.login, cwd = P.cwd(), windows = K.win.ofUser(name)})
K.loginStarted(P)
end
function handlers.TCMD(P, msg)
if not P.user then return reply(P, msg, nil, "log in first") end
if P.co then return reply(P, msg, nil, "a command is already running") end
P.consoleColumns = tonumber(msg.width) or P.consoleColumns
local line = tostring(msg.line)
P.cmdId = msg.id
P.co = coroutine.create(function() return K.runCommand(P, line) end)
P.resume()
end
function handlers.TAPPS(P, msg) reply(P, msg, K.apps()) end
function handlers.TSIZE(P, msg) reply(P, msg, K.fileSize(tostring(msg.path)) or false) end
function handlers.TREAD(P, msg)
local path = tostring(msg.path)
local size = K.fileSize(path)
if not size then return reply(P, msg, false) end
if size > MAX_READ then return reply(P, msg, nil, path .. ": too big") end
reply(P, msg, K.readFile(path) or false)
end
function handlers.TWRITE(P, msg)
if not P.user then return reply(P, msg, nil, "log in first") end
reply(P, msg, K.writeFile(tostring(msg.path), msg.data) or false)
end
function handlers.TLAUNCH(P, msg)
if not P.user then return end
K.inSession(P, function()
local id, addrOrErr = K.launchProgram(tostring(msg.path), type(msg.args) == "table" and msg.args or {})
if id then
P.print("[" .. id .. "] " .. tostring(msg.path) .. " started on " .. addrOrErr)
else
P.print("error: " .. tostring(addrOrErr))
end
end)
end
function handlers.TCONTROL(P, msg)
local job = K.jobs[msg.job]
if not P.user or not job then return end
if job.user ~= P.user and P.user ~= "root" and system.flag("kill_requires_owner") then
return P.print("process " .. tostring(msg.job) .. " is " .. tostring(job.user) .. "'s (flag kill_requires_owner)")
end
K.controlJob(job.id, tostring(msg.verb), msg.why or ("killed by " .. P.user))
end
function handlers.TCLOSE(P, msg)
local rec = K.win.get(msg.window)
if rec and rec.user == P.user then K.closeWindow(rec.id) end
end
function handlers.TGEOM(P, msg)
local rec = K.win.get(msg.window)
if rec and rec.session == P.id then K.windowGeometry(rec.id, msg.x, msg.y, msg.width, msg.height) end
end
function handlers.TATTACH(P, msg)
if not P.user then return end
local ok, err = K.attachWindow(msg.window, P)
if not ok then P.print("can't bring window " .. tostring(msg.window) .. " here: " .. tostring(err)) end
end
function handlers.TPERSIST(P, msg)
if P.user then K.togglePersist(msg.window, P) end
end
function handlers.TLOGOUT(P)
K.endLogin(P)
P.user, P.shell, P.login = nil, nil, nil
end
function handlers.TWINERR(P, msg)
local rec = K.win.get(msg.window)
if rec and rec.session == P.id then
P.print("window " .. rec.id .. " couldn't be shown here: " .. tostring(msg.error))
K.win.detach(rec)
end
end
function handlers.TFULLREL(P)
if P.fullscreen then P.fullscreen = nil end
end
function handlers.TPING() end
function handlers.TBYE(P)
T.byAddress[P.address] = nil
K.endSession(P)
end


function T.message(from, msg)
if msg.type == "TERMHELLO" then
if not system.flag("remote_terminals") then
return sendTo(from, {type = "TBYE", why = "this muxos doesn't take terminals (flag remote_terminals)"})
end
local files = {}
for _, name in ipairs(FILES) do files[name] = K.readFile("/" .. name) end
return sendTo(from, {type = "TCODE", files = files, version = K.MUXOS_VERSION})
elseif msg.type == "TREADY" then
local old = T.byAddress[from]
if old then hangUp(old, "restarted") end
local P = newProxy(from, msg)
K.addSession(P)
T.byAddress[from] = P
return
end
local P = T.byAddress[from]
if not P then
if msg.type ~= "TBYE" then sendTo(from, {type = "TBYE", why = "no session here -- restart muxterm"}) end
return
end
P.lastSeen = computer.uptime()
local handler = handlers[msg.type]
if handler then
local ok, err = pcall(handler, P, msg)
if not ok then reply(P, msg, nil, tostring(err)) end
end
end


function T.sweep()
local now = computer.uptime()
for _, P in pairs(T.byAddress) do
if now - P.lastSeen > SILENT then
hangUp(P, "the terminal stopped answering")
elseif now - P.lastSent > QUIET then
sendTo(P.address, {type = "TPING"})
P.lastSent = now
end
end
end



function T.grantFullscreen(P, job)
local holder = P.fullscreen and K.liveJob(P.fullscreen.job)
if holder and holder.id ~= job.id then
return nil, "this terminal's screen is held by process " .. holder.id
end
local key = newKey()
P.fullscreen = {job = job.id, node = job.node, key = key}
sendTo(P.address, {type = "TFULL", node = job.node, job = job.id, key = key})
return {P.address, key, PORT}
end


function T.releaseFullscreen(jobId)
local any = false
for _, P in pairs(T.byAddress) do
if P.fullscreen and P.fullscreen.job == jobId then
P.fullscreen = nil
sendTo(P.address, {type = "TUNFULL"})
any = true
end
end
return any
end


function T.jobEnded(jobId)
for _, P in pairs(T.byAddress) do sendTo(P.address, {type = "TJOBEND", job = jobId}) end
end

function T.list()
local list = {}
for _, P in pairs(T.byAddress) do list[#list + 1] = P end
return list
end

return T

@@ 4883 /windows.lua
























local K = ...
local W = {byId = {}}

local function newKey()
local parts = {}
for i = 1, 4 do parts[i] = string.format("%04x", math.random(0, 0xFFFF)) end
return table.concat(parts)
end


function W.describe(rec)
local S = rec.session and K.byId[rec.session]
return {id = rec.id, title = rec.title, x = rec.x, y = rec.y, width = rec.width, height = rec.height,
ownerJobId = rec.owner, user = rec.user, resizable = rec.resizable, decorated = rec.decorated,
attached = S ~= nil, session = S and S.id, status = rec.status}
end

function W.get(id) return W.byId[id] end


function W.route(rec)
local S = rec.session and K.byId[rec.session]
if not S then return nil end
return S.display.address, rec.key, S.display.port
end


local function announce(rec)
local address, key, port = W.route(rec)
for id in pairs(rec.holders) do
local job = K.liveJob(id)
if job then K.deliverEvent(job, {"window_route", rec.id, address or false, key or false, rec.width, rec.height, port}) end
end
end





local function clampSize(v, default)
v = math.tointeger(tonumber(v)) or default
return math.max(1, math.min(v, 160))
end

function W.open(S, spec, owner)
local job = owner and K.jobs[owner]
if not (S and S.display) and not job then return nil, "its session has ended -- no screen to open a window on" end
K.windowIds = K.windowIds + 1
local id = K.windowIds
local key = newKey()
local shown = {}
for k, v in pairs(spec) do shown[k] = v end
shown.id, shown.ownerJobId, shown.text, shown.key = id, owner, nil, key
shown.ownerNode = job and job.node
if job then shown.persist = K.isPersistent(job) end
local size, err
if S and S.display then
size, err = S.display.create(shown)
if not size then return nil, err end
else
S = nil
size = {width = clampSize(spec.width, 40), height = clampSize(spec.height, 10)}
end
local rec = {id = id, owner = owner, user = job and job.user or S.user, session = S and S.id,
title = tostring(spec.title or ("window " .. id)), x = spec.x or 1, y = spec.y or 1,
width = size.width, height = size.height, resizable = spec.resizable == true,
decorated = spec.decorated ~= false, key = key, holders = {}}
if owner then rec.holders[owner] = true end
W.byId[id] = rec
K.windowsChanged(rec.user)
return rec
end



function W.hold(rec, jobId)
rec.holders[jobId] = true
return W.route(rec)
end


function W.detach(rec)
local S = rec.session and K.byId[rec.session]
rec.session = nil
if S then pcall(S.display.remove, rec.id) end
announce(rec)
K.windowsChanged(rec.user)
end



function W.attach(rec, S)
if rec.session == S.id then return true end
local old = rec.session and K.byId[rec.session]
if old then pcall(old.display.remove, rec.id) end
rec.session = nil
local key = newKey()
local job = rec.owner and K.jobs[rec.owner]
local size, err = S.display.create({id = rec.id, title = rec.title, x = rec.x, y = rec.y,
width = rec.width, height = rec.height, resizable = rec.resizable, decorated = rec.decorated,
ownerJobId = rec.owner, ownerNode = job and job.node, key = key, persist = job and K.isPersistent(job),
code = "gpu.setBackground(0x000000) gpu.fill(1, 1, " .. rec.width .. ", " .. rec.height .. ", ' ')"})
if not size then
K.windowsChanged(rec.user)
return nil, err
end
rec.session, rec.key = S.id, key

for jobId, rect in pairs(rec.shares or {}) do
local sharer = K.liveJob(jobId)
if sharer and S.display.share then S.display.share(rec.id, jobId, rect, sharer.node) end
end
if rec.status and S.display.status then S.display.status(rec.id, rec.status) end
announce(rec)
K.windowsChanged(rec.user)
return true
end


function W.persistChanged(rec, on)
local S = rec.session and K.byId[rec.session]
if S and S.display.persist then S.display.persist(rec.id, on) end
end


function W.close(rec)
local S = rec.session and K.byId[rec.session]
W.byId[rec.id] = nil
if S then pcall(S.display.remove, rec.id) end
K.windowsChanged(rec.user)
end


function W.moved(rec, x, y, width, height)
rec.x, rec.y = x or rec.x, y or rec.y
rec.width, rec.height = width or rec.width, height or rec.height
end

function W.ownedBy(jobId)
local list = {}
for _, rec in pairs(W.byId) do
if rec.owner == jobId then list[#list + 1] = rec end
end
return list
end


function W.ofUser(user)
local list = {}
for _, rec in pairs(W.byId) do
if rec.user == user then list[#list + 1] = W.describe(rec) end
end
table.sort(list, function(a, b) return a.id < b.id end)
return list
end


function W.jobEnded(jobId, status)
for _, rec in ipairs(W.ownedBy(jobId)) do
rec.status = status
local S = rec.session and K.byId[rec.session]
if S then
if S.display.status then S.display.status(rec.id, status) end
else
W.close(rec)
end
K.windowsChanged(rec.user)
end
for _, rec in pairs(W.byId) do rec.holders[jobId] = nil end
end



function W.sessionEnded(S)
for _, rec in pairs(W.byId) do
if rec.session == S.id then
if rec.status then W.close(rec) else W.detach(rec) end
end
end
end

return W

@@ 6795 /sysbus.lua






















local K, deps = ...
local send, selfAddr = deps.send, deps.selfAddr

local B = {names = {}, calls = {}, listeners = {}, kernal = {}, running = {}}
local DEFAULT_TIMEOUT, MAX_TIMEOUT = 30, 86400
local nextCall = 0

local function validName(name)
return type(name) == "string" and #name <= 64 and name:match("^[%w_%-]+[%w_%-%.]*$") ~= nil
and not name:find("..", 1, true) and name:sub(-1) ~= "."
end

local function reserved(name)
return name == "muxos" or name:sub(1, 6) == "muxos."
end

local function answer(msg, result, err)
if not msg.id or msg.noReply then return end
if err ~= nil then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = tostring(err)})
else
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = result})
end
end

local function packed(t)
if type(t) ~= "table" then return {n = 0} end
t.n = math.tointeger(t.n) or #t
return t
end





function B.provide(name, methods)
B.kernal[name] = methods
B.names[name] = {kernal = true}
end

local function finishCall(c, ok, results)
if c.finished then return end
c.finished = true
if c.id then B.calls[c.id] = nil end
if c.console then
c.done, c.ok, c.results = true, ok, results
elseif ok then
answer(c.msg, packed(results))
else
answer(c.msg, nil, results)
end
end

local function step(entry)
local prev = K.current
K.current = nil
local ok, res = coroutine.resume(entry.co)
K.current = prev
if coroutine.status(entry.co) ~= "dead" then return false end
K.commands[entry.co] = nil
if ok then finishCall(entry.call, true, res) else finishCall(entry.call, false, tostring(res)) end
return true
end



local function startCall(c, name, method, args)
local target = validName(name) and B.names[name]
local job = target and target.job and K.liveJob(target.job)
if target and target.job and not job then
B.names[name], target = nil, nil
end
if not target then return finishCall(c, false, "no service named " .. tostring(name)) end
if type(method) ~= "string" or method == "" then return finishCall(c, false, "no method name") end
nextCall = nextCall + 1
c.id, c.name, c.method = nextCall, name, method
c.deadline = computer.uptime() + c.timeout
B.calls[c.id] = c
if target.kernal then
local fn = B.kernal[name][method]
if type(fn) ~= "function" then return finishCall(c, false, name .. " has no method " .. method) end
local ctx = {job = c.caller, user = c.user}
local co = coroutine.create(function() return table.pack(fn(ctx, table.unpack(args, 1, args.n))) end)
K.commands[co] = true
local entry = {co = co, call = c}
if not step(entry) then B.running[#B.running + 1] = entry end
else
c.service = job.id
K.deliverEvent(job, {"sysbus_call", c.id, name, method, {job = c.caller, user = c.user}, args})
end
end

local function matches(pattern, signal)
if pattern == "*" or pattern == signal then return true end
local prefix = pattern:match("^(.*)%.%*$")
return prefix ~= nil and signal:sub(1, #prefix + 1) == prefix .. "."
end


function B.signal(signal, sender, args)
args = packed(args)
for jobId, patterns in pairs(B.listeners) do
local job = K.liveJob(jobId)
if not job then
B.listeners[jobId] = nil
else
for pattern in pairs(patterns) do
if matches(pattern, signal) then
K.deliverEvent(job, {"sysbus_signal", signal, sender, args})
break
end
end
end
end
end


function B.emit(signal, ...)
B.signal(signal, {kernal = true}, table.pack(...))
end


function B.list()
local list = {}
for name, t in pairs(B.names) do
local job = t.job and K.jobs[t.job]
list[#list + 1] = {name = name, job = t.job, user = job and job.user, kernal = t.kernal or nil}
end
table.sort(list, function(a, b) return a.name < b.name end)
return list
end


function B.message(msg, caller)
if not caller then return answer(msg, nil, "not called from a running process") end
local op = msg.op
if op == "call" then
local timeout = tonumber(msg.timeout) or DEFAULT_TIMEOUT
timeout = math.max(0.1, math.min(timeout, MAX_TIMEOUT))
return startCall({msg = msg, caller = caller.id, user = caller.user, timeout = timeout},
msg.name, msg.method, packed(msg.args))
elseif op == "reply" then
local c = B.calls[msg.call]
if c and c.service == caller.id then
if msg.ok == false then finishCall(c, false, tostring(msg.error)) else finishCall(c, true, msg.result) end
end
return answer(msg, true)
elseif op == "emit" then
if not validName(msg.signal) or reserved(msg.signal) then
return answer(msg, nil, "bad signal name: " .. tostring(msg.signal))
end
B.signal(msg.signal, {job = caller.id, user = caller.user}, msg.args)
return answer(msg, true)
elseif op == "listen" or op == "unlisten" then
local pattern = msg.pattern
if not (pattern == "*" or validName(pattern) or (type(pattern) == "string" and validName(pattern:match("^(.*)%.%*$")))) then
return answer(msg, nil, "bad signal pattern: " .. tostring(pattern))
end
local set = B.listeners[caller.id] or {}
B.listeners[caller.id] = set
set[pattern] = op == "listen" or nil
return answer(msg, true)
elseif op == "own" then
local name = msg.name
if not validName(name) then return answer(msg, nil, "bad name: " .. tostring(name)) end
if reserved(name) then return answer(msg, nil, name .. " is the kernal's") end
local t = B.names[name]
local holder = t and t.job and K.liveJob(t.job)
if holder and holder.id ~= caller.id then
return answer(msg, nil, name .. " is taken (process " .. holder.id .. ")")
end
B.names[name] = {job = caller.id}
return answer(msg, true)
elseif op == "release" then
local t = B.names[msg.name]
if t and t.job == caller.id then B.names[msg.name] = nil end
return answer(msg, true)
elseif op == "list" then
return answer(msg, B.list())
end
answer(msg, nil, "unknown system bus operation: " .. tostring(op))
end



function B.consoleCall(S, name, method, args)
local c = {console = true, user = S and S.user, timeout = DEFAULT_TIMEOUT}
startCall(c, name, method, packed(args))
while not c.done do K.wait(0.05) end
return c.ok, c.results
end


function B.jobEnded(id)
for name, t in pairs(B.names) do
if t.job == id then B.names[name] = nil end
end
B.listeners[id] = nil
for _, c in pairs(B.calls) do
if c.service == id then finishCall(c, false, c.name .. " ended before answering") end
if c.caller == id and not c.console then B.calls[c.id] = nil end
end
end



function B.after(seconds, fn)
local co = coroutine.create(function()
local deadline = computer.uptime() + seconds
while computer.uptime() < deadline do K.wait(0.05) end
fn()
end)
K.commands[co] = true
B.running[#B.running + 1] = {co = co, call = {finished = true}}
end


function B.resume()
for i = #B.running, 1, -1 do
if step(B.running[i]) then table.remove(B.running, i) end
end
local now = computer.uptime()
for _, c in pairs(B.calls) do
if now > c.deadline then
finishCall(c, false, "no answer from " .. c.name .. " in " .. c.timeout .. " s")
end
end
end

return B

@@ 14661 /terminal.lua

















local ctx = ...
local CLUSTER_PORT = 4477
local PORT = ctx.port
local kernalAddr, modemAddr = ctx.kernal, ctx.modem
local myAddr = modemAddr
local component, computer = component, computer

local function serializeNumber(v)
if v ~= v then return "0/0" end
if v == math.huge then return "1/0" end
if v == -math.huge then return "-1/0" end
if math.type(v) == "integer" then return tostring(v) end
local s = string.format("%.17g", v)
if not s:find("[%.eE]") then s = s .. ".0" end
return s
end

local function serialize(v, seen)
seen = seen or {}
local t = type(v)
if t == "nil" or t == "boolean" then
return tostring(v)
elseif t == "number" then
return serializeNumber(v)
elseif t == "string" then
return string.format("%q", v)
elseif t == "table" then
if seen[v] then error("cannot serialize a cyclic table") end
seen[v] = true


local parts = {}
local n = #v
for i = 1, n do parts[i] = serialize(v[i], seen) end
for k, val in pairs(v) do
if not (math.type(k) == "integer" and k >= 1 and k <= n) then
parts[#parts + 1] = "[" .. serialize(k, seen) .. "]=" .. serialize(val, seen)
end
end


seen[v] = nil
return "{" .. table.concat(parts, ",") .. "}"
else
error("cannot serialize a value of type " .. t)
end
end

local deserialize
do






local function isData(s)
local i, n = 1, #s
while i <= n do
local q = s:find('"', i, true)
local outside = s:sub(i, (q or n + 1) - 1)
if outside:find("[^%w%s{}%[%]=,%.%-%+/]") or outside:find("%[[%[=]") or outside:find("%-%-") then
return false
end
if not q then return true end
i = q + 1
while true do
local c = s:find('[\\"]', i)
if not c then return false end
if s:byte(c) == 92 then
i = c + 2
else
i = c + 1
break
end
end
end
return true
end

deserialize = function(s)
if not isData(s) then return nil end
local chunk = load("return " .. s, "=msg", "t", {})
if not chunk then return nil end
local ok, v = pcall(chunk)
if not ok then return nil end
return v
end
end

local CHUNK_SIZE = 7000
local nextMsgId = 1



local function send(msg, port)
local payload = serialize(msg)
local id = nextMsgId
nextMsgId = nextMsgId + 1
local total = math.ceil(#payload / CHUNK_SIZE)
for i = 1, total do
local frame = "MSG " .. id .. " " .. i .. "/" .. total .. " " .. payload:sub((i - 1) * CHUNK_SIZE + 1, i * CHUNK_SIZE)
component.invoke(modemAddr, "send", msg.to, port or PORT, frame)
end
end

local incoming = {}
local function reassemble(from, data)
local msgId, i, n, chunk = data:match("^MSG (%d+) (%d+)/(%d+) (.*)$")
if not msgId then return nil end
i, n = tonumber(i), tonumber(n)
local key = from .. ":" .. msgId
local entry = incoming[key] or {chunks = {}, total = n, at = computer.uptime()}
incoming[key] = entry
entry.chunks[i] = chunk
for j = 1, entry.total do
if not entry.chunks[j] then return nil end
end
incoming[key] = nil
return table.concat(entry.chunks, "", 1, entry.total)
end

local function loadFile(name)
local source = ctx.files[name]
if not source then error("the kernal didn't send " .. name, 0) end
return assert(load(source, "=" .. name, "t", _ENV))
end



local realGpu = component.proxy(ctx.gpu)
local screenW, screenH = realGpu.getResolution()
local compositorGpu, mirror = realGpu, nil
if not realGpu.allocateBuffer then


compositorGpu = loadFile("vgpu.lua")().new(screenW, screenH, realGpu.getDepth())
mirror = function()
local cf, cb
for _, run in ipairs(compositorGpu.takeDamage()) do
if run[4] ~= cf then realGpu.setForeground(run[4]) cf = run[4] end
if run[5] ~= cb then realGpu.setBackground(run[5]) cb = run[5] end
realGpu.set(run[1], run[2], run[3])
end
end
end



local K = {selfAddr = kernalAddr, MUXOS_VERSION = ctx.version, jobs = {}, fullscreen = {},
commands = setmetatable({}, {__mode = "k"}), loadSibling = loadFile}
K.lineedit = loadFile("lineedit.lua")()
K.system = {home = function(name) return name == "root" and "/root" or "/home/" .. name end}

local S
local running, reason = true, nil
local lastHeard, lastSent = computer.uptime(), computer.uptime()
local keys = {}
local userWindows = {}
local replies, nextRequest = {}, 1
local pump



local nextLocalId = 0
function K.newCompositor(g)
return loadFile("compositor.lua")(loadFile, {gpu = g, nextId = function()
nextLocalId = nextLocalId - 1
return nextLocalId
end})
end

function K.wait(timeout)
if K.commands[coroutine.running()] then coroutine.yield() else pump(timeout) end
end

function K.resumeCommand(_, co)
K.commands[co] = true
return coroutine.resume(co)
end

function K.inSession(_, fn, ...)
local ok, err = pcall(fn, ...)
if not ok then error(err, 0) end
end

local function tell(msgType, fields)
local msg = {type = msgType, from = myAddr, to = kernalAddr}
for k, v in pairs(fields or {}) do msg[k] = v end
send(msg)
lastSent = computer.uptime()
end



local function request(msgType, fields, timeout)
local id = nextRequest
nextRequest = nextRequest + 1
local f = {id = id}
for k, v in pairs(fields or {}) do f[k] = v end
replies[id] = false
tell(msgType, f)
local deadline = timeout and computer.uptime() + timeout
while running and not replies[id] and (not deadline or computer.uptime() < deadline) do K.wait(0.1) end
local r = replies[id]
replies[id] = nil
if not r then return nil, "the kernal didn't answer" end
if r.type == "RESULT" then return r.result end
return nil, r.error
end

function K.liveJob(id)
local job = K.jobs[id]
if job and job.status == "running" then return job end
end


function K.deliverEvent(job, event)
send({type = "EVENT", from = myAddr, to = job.node, jobId = job.id, event = event}, CLUSTER_PORT)
end

function K.controlJob(id, verb, why) tell("TCONTROL", {job = id, verb = verb, why = why}) return true end
function K.closeWindow(id)
if not keys[id] then return false end
tell("TCLOSE", {window = id})
return true
end
function K.windowGeometry(id, x, y, w, h)
if keys[id] then tell("TGEOM", {window = id, x = x, y = y, width = w, height = h}) end
end
function K.userWindows() return userWindows end
function K.attachWindow(id) tell("TATTACH", {window = id}) return true end
function K.togglePersist(id) if keys[id] then tell("TPERSIST", {window = id}) end end
function K.endLogin() tell("TLOGOUT") end
function K.newShell() return nil end
function K.nextLogin() return K.pendingLogin end
function K.apps() return request("TAPPS", nil, 30) or {} end
function K.fileSize(path) return request("TSIZE", {path = path}, 10) end
function K.readFile(path) return request("TREAD", {path = path}, 60) end
function K.writeFile(path, data) return request("TWRITE", {path = path, data = data}, 10) end

function K.launchProgram(path, args) tell("TLAUNCH", {path = path, args = args}) return true end




function K.runCommand(sess, line)
if not sess.user then
local name = (line or ""):match("^%s*(.-)%s*$")
if name == "" then return end
local r, err = request("TLOGIN", {name = name}, 30)
if not r then sess.print(err) return end
K.pendingLogin, sess.remoteCwd, userWindows = r.login, r.cwd, r.windows or {}
sess.startSession(name)
return
end
if sess.command(line) then return end
local r, err = request("TCMD", {line = line, width = sess.consoleWidth()})
if r then sess.remoteCwd = r.cwd elseif err then sess.print(err) end
end



local function answer(msg, result, err)
if msg.noReply or not msg.id then return end
if result == nil then
send({type = "ERROR", from = myAddr, to = msg.from, id = msg.id, error = err}, CLUSTER_PORT)
else
send({type = "RESULT", from = myAddr, to = msg.from, id = msg.id, result = result}, CLUSTER_PORT)
end
end

local function framesPresented(list)
for _, p in ipairs(list) do
local win = S.compositor.getWindow(p.id)
if win then
local told = {}
local function tellJob(id)
local job = K.liveJob(id)
if job and not told[id] then
told[id] = true
K.deliverEvent(job, {"frame_presented", p.id, p.frame, p.complete})
end
end
if win.ownerJobId then tellJob(win.ownerJobId) end
for key in pairs(S.compositor.shares(p.id)) do tellJob(key) end
end
end
end

local function fromProgram(msg)
local id = msg.windowId
local win = id and S.compositor.getWindow(id)
if msg.type == "GPUCALL" then
local fs = K.fullscreen
if not (fs.node and fs.node == msg.from and msg.key == fs.key) then
return answer(msg, nil, "this screen's fullscreen grant isn't yours")
end
local args = type(msg.args) == "table" and msg.args or {}
local packed = table.pack(pcall(realGpu[msg.method], table.unpack(args, 1, args.n or #args)))
if not packed[1] then return answer(msg, nil, tostring(packed[2])) end
local returns = {n = packed.n - 1}
for i = 2, packed.n do returns[i - 1] = packed[i] end
return answer(msg, returns)
end
if not win or not keys[id] then return answer(msg, nil, "window " .. tostring(id) .. " isn't shown here") end
if msg.key ~= keys[id] then return answer(msg, nil, "window " .. tostring(id) .. " belongs to another process") end
local compositor = S.compositor
if msg.type == "DRAWWINDOW" then
if not msg.pixels and type(msg.width) == "number" and type(msg.height) == "number"
and (msg.width ~= win.width or msg.height ~= win.height) then
local ok, err = compositor.setGeometry(id, win.x, win.y, msg.width, msg.height)
if not ok then return answer(msg, nil, err) end
K.windowGeometry(id, win.x, win.y, win.width, win.height)
end
local ok, err = compositor.redrawWindow(id, msg)
return answer(msg, ok, err)
elseif msg.type == "DRAWREGION" then
local drawer = msg.caller == win.ownerJobId and "owner" or msg.caller
local ok, presented = compositor.drawRegion(id, drawer, msg.frame, msg, msg.done)
if not ok then return answer(msg, nil, presented) end
framesPresented(presented)
return answer(msg, true)
elseif msg.type == "RENDERCONFIG" then
if msg.options ~= nil and msg.caller ~= win.ownerJobId then
return answer(msg, nil, "window " .. id .. " belongs to another process")
end
return answer(msg, compositor.renderConfig(id, msg.options))
end
end



local fromKernal = {}
function fromKernal.RESULT(msg) replies[msg.id] = msg end
fromKernal.ERROR = fromKernal.RESULT
function fromKernal.TOUT(msg) S.write(tostring(msg.text)) end
function fromKernal.TCLEAR() S.clearConsole() end
function fromKernal.TFG(msg)
if msg.job then
K.jobs[msg.job] = {id = msg.job, node = msg.node, status = "running"}
S.beginForeground(msg.job)
else
S.endForeground()
end
end
function fromKernal.TWINDOW(msg)
local spec = msg.spec
if spec.ownerJobId and spec.ownerNode then
K.jobs[spec.ownerJobId] = {id = spec.ownerJobId, node = spec.ownerNode, status = "running"}
end
keys[spec.id] = spec.key
local ok, err = S.display.create(spec)
if not ok then
keys[spec.id] = nil
tell("TWINERR", {window = spec.id, error = tostring(err)})
end
end
function fromKernal.TWINREMOVE(msg)
keys[msg.window] = nil
if S.compositor.getWindow(msg.window) then S.compositor.close(msg.window) end
end
function fromKernal.TWINSTATUS(msg)
local win = S.compositor.getWindow(msg.window)
if win then
S.compositor.setStatus(msg.window, msg.status)
local job = win.ownerJobId and K.jobs[win.ownerJobId]
if job then job.status = "ended" end
end
end
function fromKernal.TWINPERSIST(msg)
S.display.persist(msg.window, msg.on == true)
end
function fromKernal.TOWNER(msg)
K.jobs[msg.job] = {id = msg.job, node = msg.node, status = "running"}
S.display.setOwner(msg.window, msg.job)
end
function fromKernal.TSHARE(msg)
if msg.rect and msg.node then K.jobs[msg.job] = {id = msg.job, node = msg.node, status = "running"} end
S.compositor.share(msg.window, msg.job, msg.rect)
end
function fromKernal.TUSERWINDOWS(msg)
userWindows = type(msg.list) == "table" and msg.list or {}
S.windowsChanged()
end
function fromKernal.TJOBEND(msg)
local job = K.jobs[msg.job]
if job then job.status = "ended" end
for _, winId in ipairs(S.compositor.unshareAll(msg.job)) do
local win = S.compositor.getWindow(winId)
local owner = win and win.ownerJobId and K.liveJob(win.ownerJobId)
if owner then K.deliverEvent(owner, {"region_lost", winId, msg.job}) end
end
end
function fromKernal.TFULL(msg)
K.fullscreen.node, K.fullscreen.job, K.fullscreen.key = msg.node, msg.job, msg.key
S.compositor.setExclusive(msg.node)
end
function fromKernal.TUNFULL()
K.fullscreen.node, K.fullscreen.job, K.fullscreen.key = nil, nil, nil
S.compositor.setExclusive(not S.user and "console" or nil)
S.redraw()
end
function fromKernal.TBYE(msg)
running, reason = false, "disconnected -- " .. tostring(msg.why)
end
function fromKernal.TPING() end



local INPUT = {key_down = true, key_up = true, scroll = true, clipboard = true, touch = true, drag = true, drop = true}
local held = {}

local function ours(address) return address == realGpu.getScreen() or ctx.keyboards[address] end

pump = function(timeout)
local sig = table.pack(computer.pullSignal(timeout))
local name = sig[1]
local now = computer.uptime()
if name == "modem_message" and sig[4] == PORT and type(sig[6]) == "string" then
local payload = reassemble(sig[3], sig[6])
local msg = payload and deserialize(payload)
if type(msg) == "table" and msg.from == sig[3] then
if sig[3] == kernalAddr then
lastHeard = now
local handler = fromKernal[msg.type]
if handler then
local ok, err = pcall(handler, msg)
if not ok then S.print("terminal: " .. tostring(err)) end
end
else
local ok, err = pcall(fromProgram, msg)
if not ok then answer(msg, nil, tostring(err)) end
end
end
elseif INPUT[name] and ours(sig[2]) then
if name == "key_down" then held[sig[4]] = true elseif name == "key_up" then held[sig[4]] = nil end

if name == "key_down" and sig[4] == 0x20 and (held[0x1D] or held[0x9D]) and (held[0x38] or held[0xB8]) then
tell("TBYE")
running, reason = false, "disconnected"
return
end

if name == "key_down" and sig[4] == 0x2E and K.fullscreen.node and (held[0x1D] or held[0x9D])
and (held[0x38] or held[0xB8]) then
tell("TFULLREL")
fromKernal.TUNFULL()
end
local ok, err = pcall(S.input, name, sig[3], sig[4], sig[5])
if not ok then S.print("terminal: " .. tostring(err)) end
end
for key, entry in pairs(incoming) do
if now - entry.at > 30 then incoming[key] = nil end
end
end

local function upkeep()
local now = computer.uptime()
local ok, err = pcall(function()
framesPresented(S.compositor.renderTick(function(id)
local list = {}
for key in pairs(S.compositor.shares(id)) do
if K.liveJob(key) then list[#list + 1] = key end
end
return list
end))
S.update()
S.resume()
end)
if not ok then S.print("terminal: " .. tostring(err)) end
if now - lastSent > 2 then tell("TPING") end
if now - lastHeard > 10 then running, reason = false, "lost the kernal (nothing heard for 10 s)" end
end

S = loadFile("session.lua")(K, {id = 1, gpu = compositorGpu, kind = "terminal", address = myAddr, flushed = mirror})
K.inSession(S, S.showLogin)
tell("TREADY", {width = screenW, height = screenH, depth = realGpu.getDepth(), console = S.consoleWidth()})
while running do
pump(0.05)
upkeep()
end
return reason

