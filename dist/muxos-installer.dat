local PORT = 4477
local MUXOS_VERSION = "0.1.2"
local TIMEOUT = 5





local function pullSignal(timeout)
return computer.pullSignal(timeout)
end




local function shutdown(reboot)
computer.shutdown(reboot)
end









local function componentProxy(address)
return setmetatable({address = address}, {
__index = function(_, method)
return function(...) return component.invoke(address, method, ...) end
end,
})
end

local function primaryComponent(ctype)
local address = component.list(ctype)()
if not address then return nil end
return componentProxy(address), address
end



local function serializeNumber(v)
if v ~= v then return "0/0" end
if v == math.huge then return "1/0" end
if v == -math.huge then return "-1/0" end
if math.type(v) == "integer" then return tostring(v) end
local s = string.format("%.17g", v)
if not s:find("[%.eE]") then s = s .. ".0" end
return s
end

local function serialize(v, seen)
seen = seen or {}
local t = type(v)
if t == "nil" or t == "boolean" then
return tostring(v)
elseif t == "number" then
return serializeNumber(v)
elseif t == "string" then
return string.format("%q", v)
elseif t == "table" then
if seen[v] then error("cannot serialize a cyclic table") end
seen[v] = true


local parts = {}
local n = #v
for i = 1, n do parts[i] = serialize(v[i], seen) end
for k, val in pairs(v) do
if not (math.type(k) == "integer" and k >= 1 and k <= n) then
parts[#parts + 1] = "[" .. serialize(k, seen) .. "]=" .. serialize(val, seen)
end
end


seen[v] = nil
return "{" .. table.concat(parts, ",") .. "}"
else
error("cannot serialize a value of type " .. t)
end
end

local deserialize
do






local function isData(s)
local i, n = 1, #s
while i <= n do
local q = s:find('"', i, true)
local outside = s:sub(i, (q or n + 1) - 1)
if outside:find("[^%w%s{}%[%]=,%.%-%+/]") or outside:find("%[[%[=]") or outside:find("%-%-") then
return false
end
if not q then return true end
i = q + 1
while true do
local c = s:find('[\\"]', i)
if not c then return false end
if s:byte(c) == 92 then
i = c + 2
else
i = c + 1
break
end
end
end
return true
end

deserialize = function(s)
if not isData(s) then return nil end
local chunk = load("return " .. s, "=msg", "t", {})
if not chunk then return nil end
local ok, v = pcall(chunk)
if not ok then return nil end
return v
end
end

local modem, modemAddr = primaryComponent("modem")
if not modem then
error("no network/linked card found on this node")
end
modem.open(PORT)






local eepromAddr = component.list("eeprom")()
local function tryInvoke(address, method, ...)
local ok, a, b = pcall(component.invoke, address, method, ...)
if ok then return a, b end
return nil, a
end
local fsAddr = eepromAddr and tryInvoke(eepromAddr, "getData")
if not fsAddr or fsAddr == "" then
fsAddr = component.list("filesystem")()
end
if not fsAddr then
error("no filesystem component found to read sibling files from")
end

local function readFile(path)
local handle, err = tryInvoke(fsAddr, "open", path, "r")
if not handle then return nil, err end
local parts = {}
while true do
local data = tryInvoke(fsAddr, "read", handle, math.huge)
if not data then break end
parts[#parts + 1] = data
end
tryInvoke(fsAddr, "close", handle)
return table.concat(parts)
end






local function loadSibling(name)
local source, err = readFile("/" .. name)
if not source then error("could not read /" .. name .. ": " .. tostring(err), 0) end
local chunk, loadErr = load(source, "=" .. name)
if not chunk then error("could not load /" .. name .. ": " .. tostring(loadErr), 0) end
return chunk
end






local selfAddr = modemAddr
local nodes = {}

local bus = {
components = {},
relays = {},
}
local nodeOrder = {}
local nextJobId = 1
local nextNode = 1












local fullscreen = {node = nil, job = nil}


local system = loadSibling("system.lua")({
read = readFile,
write = function(path, data)
local h, err = tryInvoke(fsAddr, "open", path, "w")
if not h then return nil, err end
local ok, werr = tryInvoke(fsAddr, "write", h, data)
tryInvoke(fsAddr, "close", h)
return ok, werr
end,
mkdir = function(path) tryInvoke(fsAddr, "makeDirectory", path) end,
})



local gpu, gpuAddr = primaryComponent("gpu")
local _, screenAddr = primaryComponent("screen")
if gpu and screenAddr then
tryInvoke(gpuAddr, "bind", screenAddr)
end














local K = {sessions = {}, byId = {}, current = nil, console = nil, commands = setmetatable({}, {__mode = "k"}),
logins = 0, windowIds = 0}


local function print(...)
local S = K.current or K.console
if S then S.print(...) end
end









local CHUNK_SIZE = 7000
local nextMsgId = 1


local function send(msg, port)
port = port or PORT
local payload = serialize(msg)
local id = nextMsgId
nextMsgId = nextMsgId + 1
local total = math.ceil(#payload / CHUNK_SIZE)
for i = 1, total do
local chunk = payload:sub((i - 1) * CHUNK_SIZE + 1, i * CHUNK_SIZE)
local frame = "MSG " .. id .. " " .. i .. "/" .. total .. " " .. chunk

if msg.to then modem.send(msg.to, port, frame) else modem.broadcast(port, frame) end
end
end






local incomingChunks = {}






local function reassemble(senderAddr, data)
local msgId, i, n, chunk = data:match("^MSG (%d+) (%d+)/(%d+) (.*)$")
if not msgId then return nil end
i, n = tonumber(i), tonumber(n)
local key = senderAddr .. ":" .. msgId
local entry = incomingChunks[key]
if not entry then
entry = {chunks = {}, total = n, startedAt = computer.uptime()}
incomingChunks[key] = entry
end
entry.chunks[i] = chunk
for j = 1, entry.total do
if not entry.chunks[j] then return nil end
end
incomingChunks[key] = nil
return table.concat(entry.chunks, "", 1, entry.total)
end

local function sweepStaleChunks()
local now = computer.uptime()
for key, entry in pairs(incomingChunks) do
if now - entry.startedAt > 10 then
incomingChunks[key] = nil
end
end
end




local function noteNode(addr)
if not nodes[addr] then
nodes[addr] = {}
nodeOrder[#nodeOrder + 1] = addr
if K.sysbus then K.sysbus.emit("muxos.node", addr, "up") end


send({type = "GETCOMPONENTS", from = selfAddr, to = addr})
end
local node = nodes[addr]
node.lastSeen = computer.uptime()
node.probedAt = nil
if node.down then
node.down = nil
print("node " .. addr .. " is responding again")
if K.sysbus then K.sysbus.emit("muxos.node", addr, "up") end
end
end


local function liveNodeCount()
local n = 0
for _, addr in ipairs(nodeOrder) do
if not nodes[addr].down and not nodes[addr].draining then n = n + 1 end
end
return n
end








local MIN_FREE_MEMORY = 64 * 1024
local function nextLiveNode(avoid)
local byLoad = system.flag("scheduler") == "load"
local roomy = false
for _, addr in ipairs(nodeOrder) do
local node = nodes[addr]
if not node.down and not node.draining and addr ~= avoid and (node.free or math.huge) >= MIN_FREE_MEMORY then
roomy = true
end
end
local best, bestLoad, bestCount
for _ = 1, #nodeOrder do
local addr = nodeOrder[nextNode]
nextNode = (nextNode % #nodeOrder) + 1
local node = nodes[addr]
if not node.down and not node.draining and addr ~= avoid
and (not byLoad or not roomy or (node.free or math.huge) >= MIN_FREE_MEMORY) then
local load = byLoad and math.floor(((node.load or 0) + (node.recent or 0)) * 10 + 0.5) or 0
local count = node.running or 0
if not best or load < bestLoad or (load == bestLoad and count < bestCount) then
best, bestLoad, bestCount = addr, load, count
end
if load == 0 and count == 0 then break end
end
end
if best then
for i, addr in ipairs(nodeOrder) do
if addr == best then nextNode = (i % #nodeOrder) + 1 break end
end
end
return best
end

local function nextId()
local id = nextJobId
nextJobId = nextJobId + 1
return id
end







local jobs = {}




local MAX_FINISHED_JOBS = 100
local finishedOrder = {}
local CODE_PREVIEW_CHARS = 40

local function codePreview(code)
if type(code) ~= "string" then return nil end
local len = utf8.len(code)
if not len then return code:sub(1, CODE_PREVIEW_CHARS) end
if len <= CODE_PREVIEW_CHARS then return code end
return code:sub(1, utf8.offset(code, CODE_PREVIEW_CHARS + 1) - 1) .. "..."
end

local function orderedJobIds()
local ids = {}
for id in pairs(jobs) do ids[#ids + 1] = id end
table.sort(ids)
return ids
end




local runningJobs = {}
local runningCount = 0
local childrenOf = {}







local appsByName = {}

local function registerOrphanCandidate(appName, id)
if not appName then return end
appsByName[appName] = appsByName[appName] or {}
local list = appsByName[appName]
list[#list + 1] = id
end

local function unregisterOrphanCandidate(appName, id)
if not appName or not appsByName[appName] then return end
local list = appsByName[appName]
for i, existingId in ipairs(list) do
if existingId == id then
table.remove(list, i)
break
end
end
end







local replyBox = {}
local awaiting = {}
















function K.sessionOf(job)
local S = job and job.session and K.byId[job.session]
if S and S.login == job.login then return S end
end



function K.windowOwner(id)
local rec = K.win and K.win.get(id)
local S = rec and rec.session and K.byId[rec.session]
local win = S and S.compositor and S.compositor.getWindow(id)
if win then return S, win, rec end
end



function K.windowsChanged(user)
for _, S in ipairs(K.sessions) do
if S.user == user and S.windowsChanged then S.windowsChanged() end
end
end



function K.releaseScreen()
local S = K.console
if S then
S.compositor.setExclusive(not S.user and "console" or nil)
S.redraw()
end
end

local function dispatchJob(code, args, targetAddr, parent, appName, orphanPolicy, program, window)
if targetAddr then
if not nodes[targetAddr] then return nil, "unknown node: " .. tostring(targetAddr) end
if nodes[targetAddr].down then return nil, "node is down: " .. targetAddr end
else
if liveNodeCount() == 0 then
return nil, "no live worker nodes -- try 'discover'"
end



targetAddr = nextLiveNode()
end
nodes[targetAddr].lastDispatch = computer.uptime()
local id = nextId()






local rootId = parent and jobs[parent] and jobs[parent].rootId or id


local S = K.current
local owner = parent and jobs[parent] or {session = S and S.id, user = S and S.user, login = S and S.login}
local user = owner.user or "root"
if program then
program.user, program.home = user, system.home(user)
program.cwd = program.cwd or (not parent and S and S.cwd()) or program.home
end
jobs[id] = {id = id, node = targetAddr, status = "running", code = code, codePreview = codePreview(code),
startedAt = computer.uptime(), user = user, login = owner.login, session = owner.session,
parent = parent, appName = appName, orphanPolicy = parent and (orphanPolicy or "orphan") or nil,
rootId = rootId, path = program and program.path, kind = program and program.kind,
program = program, args = args}
runningJobs[id] = true
runningCount = runningCount + 1
nodes[targetAddr].running = (nodes[targetAddr].running or 0) + 1
nodes[targetAddr].recent = (nodes[targetAddr].recent or 0) + 1
if parent then
childrenOf[parent] = childrenOf[parent] or {}
local siblings = childrenOf[parent]
siblings[#siblings + 1] = id
end
if parent and jobs[id].orphanPolicy == "orphan" then
registerOrphanCandidate(appName, id)
end



local route
if window then
window.owner, window.user = id, jobs[id].user
local address, key, port = K.win.hold(window, id)
route = address and {address, key, port}
local S = K.byId[window.session]
if S and S.display.setOwner then S.display.setOwner(window.id, id, targetAddr) end
end
send({type = "JOB", from = selfAddr, to = targetAddr, id = id, code = code, args = args, program = program,
windowId = window and window.id, width = window and window.width, height = window and window.height,
windowRoute = route})
return id, targetAddr
end



















local PROGRAM_PATH = {"/bin", "/usr/bin"}

local BUILTIN_MXE_LIBRARIES = {mux = true, http = true, thread = true, modem = true, bitmap = true, sysbus = true}

local MXE_LIBRARY_DIRS = {"/lib/mxe/", "/usr/lib/mxe/"}

local function fileExists(path)
return tryInvoke(fsAddr, "exists", path) == true
end

local function resolveProgram(name)
local candidates = {}
local function add(base)
if base:match("%.mxe$") or base:match("%.lua$") then
candidates[#candidates + 1] = base
else
candidates[#candidates + 1] = base .. ".mxe"
candidates[#candidates + 1] = base .. ".lua"
end
end
if name:find("/", 1, true) then
add(name)
else
for _, dir in ipairs(PROGRAM_PATH) do add(dir .. "/" .. name) end
end
for _, path in ipairs(candidates) do
if fileExists(path) then return path end
end
end





local function readManifest(source)
local body = source:match("^%s*%-%-%[%[mxe(.-)%]%]")
if not body then return {} end
local env = {}
local chunk, err = load(body, "=mxe header", "t", env)
if not chunk then return nil, "bad .mxe header: " .. tostring(err) end
local co = coroutine.create(chunk)
local ok, runErr = coroutine.resume(co)
if not ok then return nil, "bad .mxe header: " .. tostring(runErr) end
return {muxos = env.muxos, libraries = env.libraries, requires = env.requires, name = env.name,
version = env.version, description = env.description, author = env.author,
icon = env.icon, icon_color = env.icon_color}
end

local function versionParts(v)
local parts = {}
for n in tostring(v):gmatch("%d+") do parts[#parts + 1] = tonumber(n) end
return parts
end

local function sameVersion(a, b)
local x, y = versionParts(a), versionParts(b)
for i = 1, math.max(#x, #y, 1) do
if (x[i] or 0) ~= (y[i] or 0) then return false end
end
return true
end












local LEGACY_PACKAGE_PATH = {"/lib/?.lua", "/usr/lib/?.lua", "/lib/?/init.lua", "/usr/lib/?/init.lua"}
local LEGACY_FACES = {component = true, computer = true, event = true, term = true, unicode = true, pipe = true,
process = true, package = true, filesystem = true, shell = true, thread = true, tty = true}
local MAX_PREFETCH = 32
local moduleCache = {}


local function readModuleFile(path)
local modified = tryInvoke(fsAddr, "lastModified", path)
local cached = moduleCache[path]
if cached and modified and cached.modified == modified then return cached.source end
local source = readFile(path)
if source then moduleCache[path] = {source = source, modified = modified} end
return source
end



local function resolveModule(name)
if type(name) ~= "string" or name == "" or name:find("..", 1, true) then return nil end
if name:sub(1, 1) == "/" then
if (name:sub(1, 5) == "/lib/" or name:sub(1, 9) == "/usr/lib/") and fileExists(name) then return name end
return nil
end
if not name:match("^[%w_%.%-]+$") then return nil end
local rel = name:gsub("%.", "/")
for _, pattern in ipairs(LEGACY_PACKAGE_PATH) do
local path = pattern:gsub("%?", rel)
if fileExists(path) then return path end
end
end

local function literalRequires(source, into)
for name in source:gmatch("require%s*%(?%s*[\"']([^\"']+)[\"']") do into[#into + 1] = name end
end



local function prefetchModules(source)
local modules, seen, queue = {}, {}, {}
literalRequires(source, queue)
local i, count = 1, 0
while i <= #queue and count < MAX_PREFETCH do
local name = queue[i]
i = i + 1
if not LEGACY_FACES[name] and not seen[name] then
seen[name] = true
local path = resolveModule(name)
local moduleSource = path and readModuleFile(path)
if moduleSource then
modules[name] = moduleSource
count = count + 1
literalRequires(moduleSource, queue)
end
end
end
return modules
end

local launchProgram
do


local function compatibleVersion(requested, running)
if requested == nil then return true end
local r, h = versionParts(requested), versionParts(running)
local function at(t, i) return t[i] or 0 end
if at(r, 1) ~= at(h, 1) then return false end
if at(h, 1) == 0 then
return at(r, 2) == at(h, 2) and at(h, 3) >= at(r, 3)
end
return at(h, 2) > at(r, 2) or (at(h, 2) == at(r, 2) and at(h, 3) >= at(r, 3))
end




local function resolveMxeLibraries(names, response)
local libs, order, visiting = {}, {}, {}
local function visit(name)
if type(name) ~= "string" or not name:match("^[%w_%.%-]+$") or libs[name] ~= nil or visiting[name] then return end
visiting[name] = true
if BUILTIN_MXE_LIBRARIES[name] then
libs[name] = true
else
local source
for _, dir in ipairs(MXE_LIBRARY_DIRS) do
source = readFile(dir .. name .. ".lua")
if source then break end
end
if source then
local manifest = readManifest(source)
for _, dep in ipairs(manifest and type(manifest.libraries) == "table" and manifest.libraries or {}) do
visit(dep)
end
end
libs[name] = source or false
end
response.libraries[name] = libs[name] ~= false
if libs[name] then order[#order + 1] = name end
end
for _, name in ipairs(names) do visit(name) end
for name, v in pairs(libs) do
if v == false then libs[name] = nil end
end
return libs, order
end


function bus.has(ctype)
for _, c in pairs(bus.components) do
if c.type == ctype and (c.node == selfAddr or (nodes[c.node] and not nodes[c.node].down)) then return true end
end
return false
end



launchProgram = function(path, args, parent, pipe)
local source, err = readFile(path)
if not source then return nil, "can't read " .. path .. ": " .. tostring(err) end
local program = {path = path, kind = path:match("%.mxe$") and "mxe" or "legacy", pipe = pipe}
if program.kind == "mxe" then
local manifest, manifestErr = readManifest(source)
if not manifest then return nil, manifestErr end
local response = {muxos = MUXOS_VERSION, requested = manifest.muxos, libraries = {},
versionMatch = manifest.muxos == nil or sameVersion(manifest.muxos, MUXOS_VERSION),
compatible = compatibleVersion(manifest.muxos, MUXOS_VERSION), components = {}}
for _, field in ipairs({"name", "version", "description", "author"}) do
if type(manifest[field]) == "string" then response[field] = manifest[field] end
end
for _, ctype in ipairs(type(manifest.requires) == "table" and manifest.requires or {}) do
if type(ctype) == "string" then response.components[ctype] = bus.has(ctype) end
end
program.launch = response
program.libs, program.libOrder = resolveMxeLibraries(
type(manifest.libraries) == "table" and manifest.libraries or {}, response)
else
program.modules = prefetchModules(source)

local S = parent and K.sessionOf(jobs[parent]) or K.current or K.console
program.screen = {S and S.width or 80, S and S.height or 25}
program.fsAddress = fsAddr
end
local appName = path:match("([^/]+)%.%w+$")
local id, addrOrErr = dispatchJob(source, args, nil, parent, appName, nil, program)
if id and program.launch then
jobs[id].programName, jobs[id].programVersion = program.launch.name, program.launch.version
end
return id, addrOrErr
end
end









local function countRunningInTree(rootId)
local count = 0
for id in pairs(runningJobs) do
if jobs[id].rootId == rootId then
count = count + 1
end
end
return count
end



















local function applyOrphanPolicyForChildrenOf(parentId)
for _, id in ipairs(childrenOf[parentId] or {}) do
local job = jobs[id]
if not job then

elseif job.orphanPolicy == "promote" then
unregisterOrphanCandidate(job.appName, id)
job.parent = nil
elseif job.orphanPolicy == "kill" then
if job.status == "running" then
job.killReason = "killed (orphan policy, parent no longer running)"
modem.send(job.node, PORT, "KILL " .. id .. " " .. job.node)
end
job.parent = nil
elseif job.orphanPolicy == "orphan" then




job.orphanedAt = computer.uptime()
end
end
childrenOf[parentId] = nil
end





local function schedulerStress()
local live = liveNodeCount()
if live == 0 then return 0 end
return runningCount / live
end








local BASE_ORPHAN_TIMEOUT = 300

local function orphanTimeoutSeconds()
return BASE_ORPHAN_TIMEOUT / (1 + schedulerStress())
end










local KILL_RETRY_INTERVAL = 10
local ORPHAN_SWEEP_INTERVAL = 1
local lastOrphanSweep = -math.huge

local function sweepStaleOrphans()
local now = computer.uptime()
if now - lastOrphanSweep < ORPHAN_SWEEP_INTERVAL then return end
lastOrphanSweep = now
local timeout = orphanTimeoutSeconds()
for id in pairs(runningJobs) do
local job = jobs[id]
if job.orphanPolicy == "orphan" and job.orphanedAt
and now - job.orphanedAt > timeout then
if not job.lastKillSentAt or now - job.lastKillSentAt > KILL_RETRY_INTERVAL then
job.killReason = "killed (unclaimed orphan timed out)"
modem.send(job.node, PORT, "KILL " .. id .. " " .. job.node)
job.lastKillSentAt = now
unregisterOrphanCandidate(job.appName, id)
end
end
end
end




local closeJobFiles










local net = {ports = {}}

function net.release(id)
for port, owners in pairs(net.ports) do
if owners[id] then
owners[id] = nil
if next(owners) == nil then
net.ports[port] = nil
tryInvoke(modemAddr, "close", port)
end
end
end
end


function net.handle(job, msg)
local op, port = msg.op, msg.port
if op == "info" then
return {address = modemAddr, maxPacketSize = tryInvoke(modemAddr, "maxPacketSize") or 8192,
wireless = tryInvoke(modemAddr, "isWireless") == true}
end
if op ~= "send" or port ~= nil then
if math.type(port) ~= "integer" or port < 1 or port > 65535 then return nil, "bad port: " .. tostring(port) end
if port == PORT then return nil, "port " .. PORT .. " is the cluster's own" end
if K.terminals and port == K.terminals.PORT then return nil, "port " .. port .. " is muxos's terminal port" end
end
if op == "open" then
local owners = net.ports[port] or {}
if next(owners) == nil and not tryInvoke(modemAddr, "isOpen", port) then
local ok, err = tryInvoke(modemAddr, "open", port)
if not ok and err then return nil, tostring(err) end
end
local was = owners[job.id] == true
owners[job.id] = true
net.ports[port] = owners
return not was
elseif op == "close" then
local owners = net.ports[port]
if not owners or not owners[job.id] then return false end
owners[job.id] = nil
if next(owners) == nil then
net.ports[port] = nil
tryInvoke(modemAddr, "close", port)
end
return true
elseif op == "isOpen" then
return net.ports[port] ~= nil and net.ports[port][job.id] == true
elseif op == "send" or op == "broadcast" then
local data = type(msg.data) == "table" and msg.data or {}
for i = 1, data.n or #data do
local t = type(data[i])
if t ~= "nil" and t ~= "boolean" and t ~= "number" and t ~= "string" then
return nil, "a modem message can only carry nil, booleans, numbers and strings"
end
end
local ok, err
if op == "send" then
if type(msg.address) ~= "string" then return nil, "bad address" end
ok, err = tryInvoke(modemAddr, "send", msg.address, port, table.unpack(data, 1, data.n or #data))
else
ok, err = tryInvoke(modemAddr, "broadcast", port, table.unpack(data, 1, data.n or #data))
end
if not ok and err then return nil, tostring(err) end
return ok == true
end
return nil, "unknown NET operation: " .. tostring(op)
end



function net.deliver(sig)
local owners = net.ports[sig[4]]
if not owners then return end
local event = {"modem_message", sig[2], sig[3], sig[4], sig[5]}
for i = 6, sig.n do event[#event + 1] = sig[i] end
for id in pairs(owners) do
local job = jobs[id]
if job and job.status == "running" then
send({type = "EVENT", from = selfAddr, to = job.node, jobId = id, event = event})
end
end
end

local function finishJob(id, status, result, err)
local job = jobs[id]
closeJobFiles(id)
net.release(id)
K.dropShares(id)
K.sysbus.jobEnded(id)

local reader = job.pipeTo and K.liveJob(job.pipeTo)
if reader then K.deliverEvent(reader, {"pipe_closed", id, status, err}) end
if fullscreen.job == id then
fullscreen.node, fullscreen.job = nil, nil
K.releaseScreen()
end
if K.terminals then K.terminals.releaseFullscreen(id) end
runningJobs[id] = nil
runningCount = runningCount - 1
local node = nodes[job.node]
if node and node.running then node.running = node.running - 1 end
job.paused = nil
job.status, job.result, job.error = status, result, err
job.finishedAt = computer.uptime()
job.code, job.program, job.args, job.migrating = nil, nil, nil, nil
finishedOrder[#finishedOrder + 1] = id
while #finishedOrder > MAX_FINISHED_JOBS do
local old = table.remove(finishedOrder, 1)
local oldJob = jobs[old]
if oldJob then
unregisterOrphanCandidate(oldJob.appName, old)
jobs[old] = nil
childrenOf[old] = nil
end
end


K.win.jobEnded(id, (status == "done" or status == "killed") and "dead" or "error")


applyOrphanPolicyForChildrenOf(id)
end







local LIVENESS = {PROBE_AFTER = 3, DOWN_AFTER = 10, lastCheck = -math.huge}

local function markNodeDown(addr)
nodes[addr].down = true
print("node " .. addr .. " stopped responding -- marking it down")
if K.sysbus then K.sysbus.emit("muxos.node", addr, "down") end
if fullscreen.node == addr then
fullscreen.node = nil
fullscreen.job = nil
K.releaseScreen()
end
local lost = {}
for id in pairs(runningJobs) do
if jobs[id].node == addr then lost[#lost + 1] = id end
end
table.sort(lost)
for _, id in ipairs(lost) do
finishJob(id, "lost", nil, "node stopped responding")
end
end

local function checkLiveness()
local now = computer.uptime()
if now - LIVENESS.lastCheck < 1 then return end
LIVENESS.lastCheck = now
local watched = {}
for id in pairs(runningJobs) do watched[jobs[id].node] = true end
for addr in pairs(watched) do
local node = nodes[addr]
if node and not node.down then
local silent = now - math.max(node.lastSeen or 0, node.lastDispatch or 0)
if silent > LIVENESS.DOWN_AFTER then
markNodeDown(addr)
elseif silent > LIVENESS.PROBE_AFTER and (not node.probedAt or now - node.probedAt > LIVENESS.PROBE_AFTER) then
node.probedAt = now
send({type = "PING", from = selfAddr, to = addr})
end
end
end
end






local function controlJob(id, verb, reason)
local job = jobs[id]
if not job or job.status ~= "running" then
return false, "no running job " .. tostring(id)
end
if verb == "PAUSE" then
job.paused = true
elseif verb == "RESUME" then
job.paused = nil
elseif verb == "KILL" then
job.killReason = reason or "killed"
else
return false, "unknown control " .. tostring(verb)
end
modem.send(job.node, PORT, verb .. " " .. id .. " " .. job.node)
return true
end

local function isDescendantOf(id, ancestorId)
local job = jobs[id]
local seen = 0
while job and job.parent and seen < 1000 do
if job.parent == ancestorId then return true end
job = jobs[job.parent]
seen = seen + 1
end
return false
end











local function migrateJob(id, target)
local job = jobs[id]
if not job or job.status ~= "running" then return false, "no running job " .. tostring(id) end
if not job.migratable then return false, "job " .. id .. " isn't migratable (it never called mux.migratable)" end
if job.migrating then return false, "job " .. id .. " is already being migrated" end
if target then
if not nodes[target] or nodes[target].down then return false, "node isn't up: " .. tostring(target) end
if target == job.node then return false, "job " .. id .. " is already on " .. target end
else
target = nextLiveNode(job.node)
if not target then return false, "no other live node to move job " .. id .. " to" end
end
job.migrating = target
modem.send(job.node, PORT, "MIGRATE " .. id .. " " .. job.node)
return true, target
end

local function handleMigrated(msg)
local job = jobs[msg.jobId]
if not job or job.status ~= "running" or job.node ~= msg.from or not job.migrating then return end
local from, target = job.node, job.migrating
if not nodes[target] or nodes[target].down then
target = nextLiveNode(from)
end
job.migrating = nil
if not target then
finishJob(job.id, "lost", nil, "migration had no live node to restart on")
return
end
if nodes[from].running then nodes[from].running = nodes[from].running - 1 end
job.node = target
nodes[target].running = (nodes[target].running or 0) + 1
nodes[target].lastDispatch = computer.uptime()
job.migrations = (job.migrations or 0) + 1
send({type = "JOB", from = selfAddr, to = target, id = job.id, code = job.code, args = job.args,
program = job.program, restore = msg.state})
print("job [" .. job.id .. "] migrated from " .. from .. " to " .. target)
end

local function handleMigrateFailed(msg)
local job = jobs[msg.jobId]
if not job or job.node ~= msg.from or not job.migrating then return end
job.migrating = nil
print("job [" .. job.id .. "] couldn't migrate: " .. tostring(msg.error))
end

local function handleMigratable(msg)
local job = jobs[msg.jobId]
if job and job.status == "running" and job.node == msg.from and job.kind == "mxe" then
job.migratable = true
end
end



local function drainNode(addr)
local node = nodes[addr]
if not node then return false, "unknown node: " .. tostring(addr) end
node.draining = true
local moved, staying = 0, 0
for id in pairs(runningJobs) do
local job = jobs[id]
if job.node == addr then
if job.migratable and migrateJob(id) then moved = moved + 1 else staying = staying + 1 end
end
end
return true, moved, staying
end

local runtimeSource = nil

local function loadRuntime()
if runtimeSource then return runtimeSource end
local source, err = readFile("/runtime.lua")
if not source then return nil, "could not read /runtime.lua: " .. tostring(err) end
runtimeSource = source
return runtimeSource
end






local BOOT_CHUNK_SIZE = 7000

local function serveBoot(workerAddr)
local source, err = loadRuntime()
if not source then
print("boot request from " .. workerAddr .. " but " .. err)
return
end
local total = math.ceil(#source / BOOT_CHUNK_SIZE)
for i = 1, total do
local chunk = source:sub((i - 1) * BOOT_CHUNK_SIZE + 1, i * BOOT_CHUNK_SIZE)
modem.send(workerAddr, PORT, "CODE " .. i .. "/" .. total .. " " .. chunk)
end
end



















do
local EXCLUDED = {gpu = true, screen = true, keyboard = true, modem = true, tunnel = true,
eeprom = true, computer = true}
local RELAY_TIMEOUT = 10
local components, relays = bus.components, bus.relays

function bus.setNodeComponents(node, list)
for addr, c in pairs(components) do
if c.node == node then components[addr] = nil end
end
for addr, c in pairs(type(list) == "table" and list or {}) do
if type(addr) == "string" and type(c) == "table" and type(c.type) == "string" and not EXCLUDED[c.type] then
components[addr] = {type = c.type, node = node, methods = type(c.methods) == "table" and c.methods or {}}
end
end
end






function bus.forwardSignal(node, sig)
if type(sig) ~= "table" or type(sig[1]) ~= "string" or type(sig[2]) ~= "string" then return end
if sig[1] == "component_added" or sig[1] == "component_removed" then return end
local c = components[sig[2]]
if not c or c.node ~= node then return end
local event = {}
for i = 1, math.min(tonumber(sig.n) or #sig, 32) do event[i] = sig[i] end
for id in pairs(runningJobs) do
local job = jobs[id]
if job then send({type = "EVENT", from = selfAddr, to = job.node, jobId = id, event = event}) end
end
end

function bus.refreshOwn()
local list = {}
for addr, ctype in component.list() do
if addr ~= fsAddr then
local ok, methods = pcall(component.methods, addr)
list[addr] = {type = ctype, methods = ok and methods or {}}
end
end
bus.setNodeComponents(selfAddr, list)
end



local values, valueCount, nextValue = {}, 0, 1
local MAX_VALUES = 64

local function isPlain(v, depth)
local t = type(v)
if t == "nil" or t == "boolean" or t == "number" or t == "string" then return true end
if t ~= "table" or depth > 8 then return false end
for k, x in pairs(v) do
if not isPlain(k, depth + 1) or not isPlain(x, depth + 1) then return false end
end
return true
end

local function exportValue(v)
if isPlain(v, 0) then return v end
if valueCount >= MAX_VALUES then
local oldest = math.huge
for k in pairs(values) do if k < oldest then oldest = k end end
local old = values[oldest]
values[oldest], valueCount = nil, valueCount - 1
pcall(function() old.close() end)
end
local n = nextValue
nextValue, valueCount = n + 1, valueCount + 1
values[n] = v
return {__busValue = n, node = selfAddr}
end

local function reply(msg, packed)
if packed[1] then
local returns = {n = packed.n - 1}
for i = 2, packed.n do returns[i - 1] = exportValue(packed[i]) end
if pcall(send, {type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = returns}) then return end
packed = {false, "the result can't be sent"}
end
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = tostring(packed[2])})
end

function bus.fail(msg, err)
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = err})
end



local function relay(node, msg, fields)
local id = nextId()
relays[id] = {to = msg.from, id = msg.id, node = node, expires = computer.uptime() + RELAY_TIMEOUT}
fields.from, fields.to, fields.id = selfAddr, node, id
send(fields)
end

function bus.sweep()
local now = computer.uptime()
for id, r in pairs(relays) do
if now > r.expires then relays[id] = nil end
end
end

local function nodeUp(node)
return node == selfAddr or (nodes[node] and not nodes[node].down)
end

function bus.list(msg)
local list = {}
for addr, c in pairs(components) do
if nodeUp(c.node) then list[addr] = {type = c.type, node = c.node, methods = c.methods} end
end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = list})
end

function bus.invoke(msg)
local c = components[msg.address]
if not c or not nodeUp(c.node) then return bus.fail(msg, "no such component") end
local args = type(msg.args) == "table" and msg.args or {n = 0}
if c.node == selfAddr then
reply(msg, table.pack(pcall(component.invoke, msg.address, msg.method, table.unpack(args, 1, args.n or #args))))
else
relay(c.node, msg, {type = "INVOKE", address = msg.address, method = msg.method, args = args})
end
end

function bus.valueCall(msg)
local args = type(msg.args) == "table" and msg.args or {n = 0}
if msg.node == selfAddr then
local v = values[msg.value]
if v == nil then return bus.fail(msg, "that value is gone (closed, or its node restarted)") end
reply(msg, table.pack(pcall(function() return v[msg.method](table.unpack(args, 1, args.n or #args)) end)))
if msg.method == "close" then values[msg.value], valueCount = nil, valueCount - 1 end
elseif msg.node ~= nil and nodeUp(msg.node) then
relay(msg.node, msg, {type = "VALUECALL", value = msg.value, method = msg.method, args = args})
else
bus.fail(msg, "that value's node is gone")
end
end
end
bus.refreshOwn()

local function handleList(msg)
local list = {}
for addr, ctype in component.list() do
list[addr] = ctype
end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = list})
end





local function isDisplayComponent(address)
return address == gpuAddr or address == screenAddr
end

local function handleInvoke(msg)
if isDisplayComponent(msg.address) and msg.from ~= fullscreen.node then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id,
error = "direct gpu/screen access is blocked -- use create_window, or gmuxapi.request_fullscreen() for exclusive access"})
return
end
local args = msg.args or {}
local packed = table.pack(pcall(component.invoke, msg.address, msg.method, table.unpack(args, 1, args.n or #args)))
if packed[1] then



local returns = {n = packed.n - 1}
for i = 2, packed.n do returns[i - 1] = packed[i] end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = returns})
else
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = tostring(packed[2])})
end
end





local function handleRequestFullscreen(msg)
if fullscreen.node and fullscreen.node ~= msg.from then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id,
error = "fullscreen already held by " .. fullscreen.node})
return
end
local job = jobs[msg.caller]
job = job and job.status == "running" and job.node == msg.from and job or nil

local S = job and K.sessionOf(job)
if S and S.kind == "terminal" then
local route, err = K.terminals.grantFullscreen(S, job)
if route then
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = {granted = true, route = route}})
else
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = err})
end
return
end
if not K.console then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = "the kernal has no screen"})
return
end
fullscreen.node, fullscreen.job = msg.from, job and job.id
K.console.compositor.setExclusive(msg.from)
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = {granted = true}})
end

local function handleReleaseFullscreen(msg)
local caller = jobs[msg.caller]
if caller and caller.node == msg.from and K.terminals.releaseFullscreen(caller.id) then
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = {released = true}})
return
end
if fullscreen.node ~= msg.from then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id,
error = "you do not hold the fullscreen grant"})
return
end
fullscreen.node = nil
fullscreen.job = nil
K.releaseScreen()
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = {released = true}})
end









local VALID_ORPHAN_POLICIES = {orphan = true, kill = true, promote = true}

local function handleSpawn(msg)
if not msg.code then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id,
error = "spawn needs options.code (a Lua source string) -- gmux's options.main/main_path can't cross the network"})
return
end
if msg.orphanPolicy and not VALID_ORPHAN_POLICIES[msg.orphanPolicy] then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id,
error = "orphanPolicy must be one of orphan/kill/promote, got " .. tostring(msg.orphanPolicy)})
return
end
if msg.parent and jobs[msg.parent] then
local rootId = jobs[msg.parent].rootId or msg.parent
local running = countRunningInTree(rootId)
local live = liveNodeCount()
if running >= live then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id,
error = "fan-out cap reached: this job tree already has " .. running ..
" running job(s), as many as there are live worker nodes (" .. live .. ")"})
return
end
end


local window
local S = K.sessionOf(jobs[msg.parent])
if type(msg.graphics) == "table" then
local g = msg.graphics
local err
if not S then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = "its session has ended -- no screen to open a window on"})
return
end
window, err = K.win.open(S, {title = tostring(g.title or "graphics"), x = g.x, y = g.y,
width = tonumber(g.width) or 40, height = tonumber(g.height) or 12,
resizable = g.resizable, decorated = g.decorated,
code = "gpu.setBackground(0x000000) gpu.fill(1, 1, " .. (tonumber(g.width) or 40) .. ", "
.. (tonumber(g.height) or 12) .. ", ' ')"})
if not window then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = err})
return
end
end
local jobId, targetAddr = dispatchJob(msg.code, msg.args, msg.node, msg.parent, msg.appName, msg.orphanPolicy,
nil, window)
if not jobId then
if window then K.win.close(window) end
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = targetAddr})
return
end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id,
result = {id = jobId, node = targetAddr, window = window and K.win.describe(window)}})
end














local function handleControl(msg)
local caller = jobs[msg.caller]
if not caller or caller.status ~= "running" or caller.node ~= msg.from then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = "not called from a running process"})
return
end
if not isDescendantOf(msg.jobId, msg.caller) then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id,
error = "job " .. tostring(msg.jobId) .. " is not a descendant of job " .. tostring(msg.caller)})
return
end
local ok, err = controlJob(msg.jobId, msg.verb, "killed by parent job " .. tostring(msg.caller))
if not ok then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = err})
return
end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = true})
end



local function callerJob(msg)
local job = jobs[msg.caller]
if job and job.status == "running" and job.node == msg.from then return job end
end

local function handleOutput(msg)
local job = jobs[msg.jobId]
if not job or job.node ~= msg.from or type(msg.text) ~= "string" then return end


if job.pipeTo then
local reader = K.liveJob(job.pipeTo)
if reader then
K.deliverEvent(reader, {job.pipeMode:find("r") and "pipe_data" or "pipe_output", job.id, msg.text})
end
return
end
local S = K.sessionOf(job)
if S then
S.write(msg.text)
else

job.away = ((job.away or "") .. msg.text):sub(-4096)
end
end


local function handleLaunch(msg)
local caller = callerJob(msg)
local path = type(msg.path) == "string" and resolveProgram(msg.path)
local reply
if not caller then
reply = "not called from a running process"
elseif not path then
reply = "program not found: " .. tostring(msg.path)
else
local pipe = (msg.pipe == "r" or msg.pipe == "w" or msg.pipe == "rw") and msg.pipe or nil
local id, addrOrErr = launchProgram(path, type(msg.args) == "table" and msg.args or {}, caller.id, pipe)
if id and pipe then jobs[id].pipeTo, jobs[id].pipeMode = caller.id, pipe end
if id then
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = {id = id, node = addrOrErr, path = path}})
return
end
reply = addrOrErr
end
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = reply})
end



local function handleGetModule(msg)
if not callerJob(msg) then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = "not called from a running process"})
return
end


local path = msg.name == "muxos:bitmap" and "/bitmap.lua" or resolveModule(msg.name)
local source = path and (msg.name == "muxos:bitmap" and readFile(path) or readModuleFile(path))
if source then
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = {path = path, source = source}})
else
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id,
error = "module '" .. tostring(msg.name) .. "' not found"})
end
end








local FS_OPS = {exists = true, isDirectory = true, size = true, lastModified = true, list = true,
makeDirectory = true, remove = true, rename = true, spaceUsed = true, spaceTotal = true,
isReadOnly = true, getLabel = true, open = true, read = true, write = true, seek = true, close = true}
local FS_READ_MAX = 65536
local fsHandles = {}
local nextFsHandle = 1

closeJobFiles = function(jobId)
for n, h in pairs(fsHandles) do
if h.job == jobId then
tryInvoke(fsAddr, "close", h.real)
fsHandles[n] = nil
end
end
end

local function handleFs(msg)
local caller = callerJob(msg)
local function fail(err)
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = tostring(err)})
end
if not caller then return fail("not called from a running process") end
local op, args = msg.op, type(msg.args) == "table" and msg.args or {n = 0}
if not FS_OPS[op] then return fail("no such method: " .. tostring(op)) end
local h
if op == "read" or op == "write" or op == "seek" or op == "close" then
h = fsHandles[args[1]]
if not h or h.job ~= caller.id then return fail("bad file descriptor") end
end
local result
if op == "read" then
local want = math.min(tonumber(args[2]) or FS_READ_MAX, FS_READ_MAX)
local parts, got = {}, 0
while got < want do
local ok, data, err = pcall(component.invoke, fsAddr, "read", h.real, want - got)
if not ok then return fail(data) end
if data == nil then
if err then return fail(err) end
break
end
parts[#parts + 1] = data
got = got + #data
end
result = {n = 1, got > 0 and table.concat(parts) or nil}
else
local callArgs = {table.unpack(args, 1, args.n or #args)}
if h then callArgs[1] = h.real end
result = table.pack(pcall(component.invoke, fsAddr, op, table.unpack(callArgs, 1, args.n or #args)))
if not result[1] then return fail(result[2]) end
table.remove(result, 1)
result.n = result.n - 1
if op == "open" and result[1] ~= nil then
fsHandles[nextFsHandle] = {real = result[1], job = caller.id}
result[1] = nextFsHandle
nextFsHandle = nextFsHandle + 1
elseif op == "close" then
fsHandles[args[1]] = nil
end
end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = result})
end

local function handleGetOrphans(msg)
local list, keep = {}, {}
for _, id in ipairs(appsByName[msg.appName] or {}) do
local job = jobs[id]
if job and job.orphanedAt then
list[#list + 1] = {id = job.id, node = job.node, status = job.status,
result = job.result, error = job.error}
elseif job then
keep[#keep + 1] = id
end
end
appsByName[msg.appName] = #keep > 0 and keep or nil
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = list})
end





local function handleCreateWindow(msg)
msg.text = nil


if not msg.ownerJobId then
local caller = callerJob(msg)
msg.ownerJobId = caller and caller.id
end
local caller = callerJob(msg)
local S = K.sessionOf(jobs[msg.ownerJobId] or caller)
local rec, err = K.win.open(S, msg, msg.ownerJobId)
if not rec then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = err})
return
end

local result = K.win.describe(rec)
if caller then result.route, result.key, result.port = K.win.hold(rec, caller.id) end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = result})
end






local function handleDrawWindow(msg)
local caller = callerJob(msg)
local S, win, rec = K.windowOwner(msg.windowId)
local reply
if not caller then
reply = "not called from a running process"
elseif not win then
reply = K.win.get(msg.windowId) and "window " .. tostring(msg.windowId) .. " isn't shown on this screen"
or "no such window: " .. tostring(msg.windowId)
elseif msg.key ~= rec.key and win.ownerJobId ~= caller.id
and not (win.ownerJobId and isDescendantOf(win.ownerJobId, caller.id)) then
reply = "window " .. tostring(msg.windowId) .. " belongs to another process"
end



if not reply and not msg.pixels and type(msg.width) == "number" and type(msg.height) == "number"
and (msg.width ~= win.width or msg.height ~= win.height) then
local ok, err = S.compositor.setGeometry(win.id, win.x, win.y, msg.width, msg.height)
if not ok then reply = err else K.win.moved(rec, win.x, win.y, win.width, win.height) end
end
if not reply then
local ok, err = S.compositor.redrawWindow(msg.windowId, msg)
if ok then
if not msg.noReply then send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = true}) end
return
end
reply = err
end
if not msg.noReply then send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = reply}) end
end




local function managesWindow(caller, win)
return caller and win.ownerJobId and (win.ownerJobId == caller.id or isDescendantOf(win.ownerJobId, caller.id))
end



function K.framesPresented(S, list)
for _, p in ipairs(list) do
local win = S.compositor.getWindow(p.id)
if win then
local told = {}
local function tell(id)
local job = K.liveJob(id)
if job and not told[id] then
told[id] = true
K.deliverEvent(job, {"frame_presented", p.id, p.frame, p.complete})
end
end
if win.ownerJobId then tell(win.ownerJobId) end
for key in pairs(S.compositor.shares(p.id)) do tell(key) end
end
end
end


function K.expectedRegions(S, id)
local list = {}
for key in pairs(S.compositor.shares(id)) do
if K.liveJob(key) then list[#list + 1] = key end
end
return list
end



function K.dropShares(id)
for _, rec in pairs(K.win.byId) do
if rec.shares then rec.shares[id] = nil end
end
for _, S in ipairs(K.sessions) do
for _, winId in ipairs(S.compositor and S.compositor.unshareAll(id) or {}) do
local win = S.compositor.getWindow(winId)
local owner = win and win.ownerJobId and K.liveJob(win.ownerJobId)
if owner then K.deliverEvent(owner, {"region_lost", winId, id}) end
end
end
if K.terminals then K.terminals.jobEnded(id) end
end



local function shareElsewhere(rec, caller, child, rect)
local S = rec.session and K.byId[rec.session]
if rect ~= nil then
local x, y = math.tointeger(rect.x or rect[1]), math.tointeger(rect.y or rect[2])
local w, h = math.tointeger(rect.w or rect[3]), math.tointeger(rect.h or rect[4])
if not (x and y and w and h) or x < 1 or y < 1 or w < 1 or h < 1 or x + w - 1 > rec.width or y + h - 1 > rec.height then
return nil, "the rectangle must be whole cells within the window (" .. rec.width .. "x" .. rec.height .. ")"
end
rect = {x = x, y = y, w = w, h = h}
end
rec.shares = rec.shares or {}
rec.shares[child.id] = rect
if S and S.display.share then S.display.share(rec.id, child.id, rect, child.node) end
if rect then K.win.hold(rec, child.id) end
return rect
end

local function handleRender(msg)
local caller = callerJob(msg)
local rec = K.win.get(msg.windowId)
if msg.type == "SHAREWINDOW" and rec and not K.windowOwner(msg.windowId) then
local child = K.liveJob(msg.child)
local function fail(err) send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = err}) end
if not caller then return fail("not called from a running process") end
if rec.owner ~= caller.id and not (rec.owner and isDescendantOf(rec.owner, caller.id)) then
return fail("window " .. rec.id .. " belongs to another process")
end
if not child or not isDescendantOf(child.id, caller.id) then
return fail("process " .. tostring(msg.child) .. " isn't a running descendant of yours")
end
local rect, err = shareElsewhere(rec, caller, child, msg.rect)
if msg.rect ~= nil and not rect then return fail(err) end
K.deliverEvent(child, rect and {"window_shared", rec.id, rect.x, rect.y, rect.w, rect.h} or {"window_unshared", rec.id})
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = true})
return
end
local S, win = K.windowOwner(msg.windowId)
local function reply(result, err)
if msg.noReply then return end
if result == nil then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = err})
else
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = result})
end
end
if not caller then return reply(nil, "not called from a running process") end
if not win then return reply(nil, "no such window: " .. tostring(msg.windowId)) end
local manager = managesWindow(caller, win)
if msg.type == "SHAREWINDOW" then
local child = K.liveJob(msg.child)
if not manager then return reply(nil, "window " .. win.id .. " belongs to another process") end
if not child or not isDescendantOf(child.id, caller.id) then
return reply(nil, "process " .. tostring(msg.child) .. " isn't a running descendant of yours")
end
local ok, err = S.compositor.share(win.id, child.id, msg.rect)
if not ok then return reply(nil, err) end
local rect = S.compositor.shares(win.id)[child.id]
local rec = K.win.get(win.id)
rec.shares = rec.shares or {}
rec.shares[child.id] = rect
if rect then K.win.hold(rec, child.id) end
K.deliverEvent(child, rect and {"window_shared", win.id, rect.x, rect.y, rect.w, rect.h} or {"window_unshared", win.id})
return reply(true)
elseif msg.type == "RENDERCONFIG" then
if not manager and (msg.options ~= nil or not S.compositor.shares(win.id)[caller.id]) then
return reply(nil, "window " .. win.id .. " belongs to another process")
end
return reply(S.compositor.renderConfig(win.id, manager and msg.options or nil))
end

local ok, presented = S.compositor.drawRegion(win.id, manager and "owner" or caller.id, msg.frame, msg, msg.done)
if not ok then return reply(nil, presented) end
K.framesPresented(S, presented)
reply(true)
end




local function handlePipeWrite(msg)
local caller = callerJob(msg)
local child = K.liveJob(msg.child)
if not caller or not child or child.pipeTo ~= caller.id then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = "no pipe to process " .. tostring(msg.child)})
return
end
if type(msg.text) == "string" then K.deliverEvent(child, {"pipe_data", "stdin", msg.text}) end
if msg.close then K.deliverEvent(child, {"pipe_closed", "stdin"}) end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = true})
end


local function handleGetWindows(msg)
local caller = callerJob(msg)
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = caller and K.win.ofUser(caller.user) or {}})
end




local function handleWindowRoute(msg)
local caller = callerJob(msg)
local rec = K.win.get(msg.windowId)
local may = caller and rec and (rec.owner == caller.id or (rec.owner and isDescendantOf(rec.owner, caller.id))
or (rec.shares and rec.shares[caller.id]))
if not may then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = rec and "window " .. rec.id
.. " belongs to another process" or "no such window: " .. tostring(msg.windowId)})
return
end
local address, key, port = K.win.hold(rec, caller.id)
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id,
result = {address = address, key = key, port = port, width = rec.width, height = rec.height}})
end




local function handlePersist(msg)
local caller = callerJob(msg)
if not caller then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = "not called from a running process"})
return
end

local on = msg.on
if on ~= nil then K.setPersistent(caller, on ~= false) end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = K.isPersistent(caller)})
end









local SUMMARY_FIELDS = {"id", "node", "status", "startedAt", "finishedAt", "parent", "appName",
"orphanPolicy", "rootId", "codePreview", "error", "paused", "kind", "path", "migratable", "migrations",
"programName", "programVersion", "user", "persistent"}

local function handleGetProcesses(msg)
local list = {}
for _, id in ipairs(orderedJobIds()) do
local job, summary = jobs[id], {}
for _, field in ipairs(SUMMARY_FIELDS) do summary[field] = job[field] end
list[#list + 1] = summary
end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = list})
end

local function handleGetProcess(msg)
local job = jobs[msg.jobId]
if not job then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id,
error = "no such job (or it has been dropped from history): " .. tostring(msg.jobId)})
return
end
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = job})
end






local function handleModemMessage(from, port, data)
if not (port == PORT and type(data) == "string") then return end

local bootFrom = data:match("^BOOT (.+)$")
if bootFrom then
serveBoot(bootFrom)
return
end

local payload = reassemble(from, data)
if not payload then
return
end

local msg = deserialize(payload)




if type(msg) ~= "table" or msg.from ~= from or from == selfAddr then
return
end




if msg.type == "HELLO" or msg.type == "PONG" or nodes[msg.from] then
noteNode(msg.from)
end
if msg.to ~= selfAddr then
return
end

if msg.type == "LIST" then
handleList(msg)
elseif msg.type == "INVOKE" then
handleInvoke(msg)
elseif msg.type == "SHAREWINDOW" or msg.type == "RENDERCONFIG" or msg.type == "DRAWREGION" then
handleRender(msg)
elseif msg.type == "PIPEWRITE" then
handlePipeWrite(msg)
elseif msg.type == "WINDOWROUTE" then
handleWindowRoute(msg)
elseif msg.type == "PERSIST" then
handlePersist(msg)
elseif msg.type == "SBUS" then
K.sysbus.message(msg, callerJob(msg))
elseif msg.type == "ISFOREGROUND" then

local caller = callerJob(msg)
local S = caller and K.sessionOf(caller)
if S and S.foregroundJob == caller.id then
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = true})
else
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id,
error = "not in the foreground at the console"})
end
elseif msg.type == "LOAD" then

local node = nodes[msg.from]
if node and type(msg.load) == "number" then
node.load, node.load60, node.free, node.total = msg.load, tonumber(msg.load60), tonumber(msg.free), tonumber(msg.total)
node.recent = 0
end
elseif msg.type == "COMPONENTS" then
bus.setNodeComponents(msg.from, msg.components)
elseif msg.type == "BUSLIST" or msg.type == "BUSINVOKE" or msg.type == "VALUECALL" then
if not callerJob(msg) then
bus.fail(msg, "not called from a running process")
elseif msg.type == "BUSLIST" then
bus.list(msg)
elseif msg.type == "BUSINVOKE" then
bus.invoke(msg)
else
bus.valueCall(msg)
end
elseif msg.type == "GETPROCESSES" then
handleGetProcesses(msg)
elseif msg.type == "GETPROCESS" then
handleGetProcess(msg)
elseif msg.type == "SPAWN" then
handleSpawn(msg)
elseif msg.type == "GETORPHANS" then
handleGetOrphans(msg)
elseif msg.type == "CONTROL" then
handleControl(msg)
elseif msg.type == "OUTPUT" then
handleOutput(msg)
elseif msg.type == "MIGRATED" then
handleMigrated(msg)
elseif msg.type == "MIGRATEFAILED" then
handleMigrateFailed(msg)
elseif msg.type == "MIGRATABLE" then
handleMigratable(msg)
elseif msg.type == "FS" then
handleFs(msg)
elseif msg.type == "GETMODULE" then
handleGetModule(msg)
elseif msg.type == "LAUNCH" then
handleLaunch(msg)
elseif msg.type == "CREATEWINDOW" then
handleCreateWindow(msg)
elseif msg.type == "GETWINDOWS" then
handleGetWindows(msg)
elseif msg.type == "DRAWWINDOW" then
handleDrawWindow(msg)
elseif msg.type == "SIGNAL" then
bus.forwardSignal(msg.from, msg.signal)
elseif msg.type == "NET" then
local job = callerJob(msg)
local result, err
if job then result, err = net.handle(job, msg) else err = "not called from a running process" end
if err then
send({type = "ERROR", from = selfAddr, to = msg.from, id = msg.id, error = err})
else
send({type = "RESULT", from = selfAddr, to = msg.from, id = msg.id, result = result})
end
elseif msg.type == "REQUESTFULLSCREEN" then
handleRequestFullscreen(msg)
elseif msg.type == "RELEASEFULLSCREEN" then
handleReleaseFullscreen(msg)
elseif msg.type == "PONG" or msg.type == "RESULT" or msg.type == "ERROR" then
local relay = msg.id and bus.relays[msg.id]
if relay and relay.node == msg.from and msg.type ~= "PONG" then
bus.relays[msg.id] = nil
send({type = msg.type, from = selfAddr, to = relay.to, id = relay.id, result = msg.result, error = msg.error})
return
end
if msg.id then
if awaiting[msg.id] == msg.from then
replyBox[msg.id] = msg
end





if (msg.type == "RESULT" or msg.type == "ERROR") and jobs[msg.id] and jobs[msg.id].status == "running"
and jobs[msg.id].node == msg.from then
local job = jobs[msg.id]
if msg.type == "RESULT" then
finishJob(msg.id, "done", msg.result, nil)
elseif job.killReason and msg.error == "killed" then
finishJob(msg.id, "killed", nil, job.killReason)
else
finishJob(msg.id, "error", nil, msg.error)
end
end
end
end
end



function K.inSession(S, fn, ...)
local prev = K.current
K.current = S
local ok, err = pcall(fn, ...)
K.current = prev
if not ok then error(err, 0) end
end

local INPUT = {key_down = true, key_up = true, scroll = true, clipboard = true, touch = true, drag = true, drop = true}










local function tick(timeout)
local sig = table.pack(pullSignal(timeout))
local name, a2, a3, a4, a5, a6 = table.unpack(sig, 1, 6)
local ok, err = pcall(function()
if name == "modem_message" and a4 ~= PORT then net.deliver(sig) end
if type(a2) == "string" and bus.components[a2] then bus.forwardSignal(selfAddr, sig) end
if INPUT[name] then

if K.console then K.inSession(K.console, K.console.input, name, a3, a4, a5) end
elseif name == "component_added" or name == "component_removed" then
bus.refreshOwn()
elseif name == "modem_message" then
if a4 == PORT then
handleModemMessage(a3, a4, a6)
elseif K.terminals and a4 == K.terminals.PORT and type(a6) == "string" then
local payload = reassemble(a3, a6)
local msg = payload and deserialize(payload)
if type(msg) == "table" and msg.from == a3 then K.terminals.message(a3, msg) end
end
end
sweepStaleChunks()
bus.sweep()
sweepStaleOrphans()
checkLiveness()
if K.terminals then K.terminals.sweep() end
for _, S in ipairs(K.sessions) do
if S.compositor then
K.framesPresented(S, S.compositor.renderTick(function(id) return K.expectedRegions(S, id) end))
end
K.inSession(S, S.update)
end
end)
if not ok then
print("tick error (continuing): " .. tostring(err))
end
end



function K.wait(timeout)
if K.commands[coroutine.running()] then
coroutine.yield()
else
tick(timeout)
end
end


function K.resumeCommand(S, co)
local prev = K.current
K.current = S
K.commands[co] = true
local ok, err = coroutine.resume(co)
K.current = prev
return ok, err
end

local function waitSeconds(duration)
local deadline = computer.uptime() + duration
while computer.uptime() < deadline do
K.wait(deadline - computer.uptime())
end
end




local function discover(wait)
send({type = "PING", from = selfAddr})
waitSeconds(wait or 1)
end




local function waitForReply(id, addr, timeout)
local deadline = computer.uptime() + (timeout or TIMEOUT)
awaiting[id] = addr
while computer.uptime() < deadline do
local msg = replyBox[id]
if msg then
replyBox[id] = nil
awaiting[id] = nil
return msg
end
K.wait(deadline - computer.uptime())
end
awaiting[id] = nil
return nil, "timed out waiting for " .. tostring(addr)
end

local function awaitReply(id, addr)
local msg, err = waitForReply(id, addr)
if not msg then return nil, err end
if msg.type == "RESULT" then return msg.result end
return nil, msg.error
end




local function submit(code, args, targetAddr)
local id, addrOrErr = dispatchJob(code, args, targetAddr)
if not id then
return nil, addrOrErr
end
return awaitReply(id, addrOrErr)
end


local function listComponents(addr)
local id = nextId()
send({type = "LIST", from = selfAddr, to = addr, id = id})
return awaitReply(id, addr)
end






local function invoke(addr, componentAddr, method, args)
local id = nextId()
send({type = "INVOKE", from = selfAddr, to = addr, id = id, address = componentAddr, method = method, args = args})
return awaitReply(id, addr)
end






local function pingOnce(addr, id)
local sentAt = computer.uptime()
send({type = "PING", from = selfAddr, to = addr, id = id})
local msg, err = waitForReply(id, addr)
if not msg then return nil, err end
return computer.uptime() - sentAt
end

local function pingReport(addr, count)
count = count or 3
local min, max, total, replies = nil, nil, 0, 0
for _ = 1, count do
local rtt, err = pingOnce(addr, nextId())
if rtt then
replies = replies + 1
total = total + rtt
min = (not min or rtt < min) and rtt or min
max = (not max or rtt > max) and rtt or max
print(string.format("  reply from %s: time=%.1fms", addr, rtt * 1000))
else
print(string.format("  no reply from %s (%s)", addr, err))
end
end
if replies > 0 then
print(string.format("%d/%d replies -- min/avg/max = %.1f/%.1f/%.1fms",
replies, count, min * 1000, (total / replies) * 1000, max * 1000))
end
end



local function resolveNode(token)
local index = tonumber(token)
if index and nodeOrder[index] then
return nodeOrder[index]
end
return token
end

local function listNodes()
if #nodeOrder == 0 then
print("no worker nodes known -- try 'discover'")
return
end
for i, addr in ipairs(nodeOrder) do
local node = nodes[addr]
local load = node.load and string.format("  load %.2f %.2f  %dK free", node.load, node.load60 or 0,
(node.free or 0) // 1024) or ""
print(string.format("[%d] %s  (last seen %.1fs ago)%s%s", i, addr, computer.uptime() - node.lastSeen,
node.down and " DOWN" or (node.draining and " DRAINING" or ""), load))
end
end

local function printComponents(addr)
local list, err = listComponents(addr)
if err then
print("error: " .. err)
return
end
for compAddr, ctype in pairs(list) do
print(string.format("%s  %s", compAddr, ctype))
end
end




local function printProcesses()
local ids = orderedJobIds()
if #ids == 0 then
print("no jobs dispatched yet")
return
end
for _, id in ipairs(ids) do
local job = jobs[id]
local parentInfo = ""
if job.appName or job.orphanPolicy then
parentInfo = string.format(" (parent=%s app=%s policy=%s)",
job.parent and tostring(job.parent) or "none", tostring(job.appName), tostring(job.orphanPolicy))
end
print(string.format("[%d] %s on %s as %s%s%s", job.id, job.paused and "paused" or job.status, job.node,
job.user or "root", job.error and (" -- " .. job.error) or "", parentInfo))
end
end












local updates = {DAT = "/muxos-installer.dat", CHUNK = 8192}



function updates.read(addr, path)
local h, err = tryInvoke(addr, "open", path)
if not h then return nil, tostring(err) end
local parts = {}
while true do
local data, readErr = tryInvoke(addr, "read", h, math.huge)
if not data then
tryInvoke(addr, "close", h)
if readErr then return nil, tostring(readErr) end
return table.concat(parts)
end
parts[#parts + 1] = data
if #parts % 16 == 0 then K.wait(0) end
end
end


function updates.parse(data)
local version, pos = data:match("^%-%-%[=*%[MUXOS%-PAYLOAD ([^\n]+)\n()")
if not version then return nil, "not a muxos installer data file" end
if version:sub(-1) == "\r" then return nil, "its line endings were converted to CRLF -- copy it again as-is" end
local count
count, pos = data:match("^@@MANIFEST (%d+)\n()", pos)
if not count then return nil, "damaged (no manifest)" end
for _ = 1, tonumber(count) do
pos = data:match("^[^\n]*\n()", pos)
if not pos then return nil, "damaged (manifest)" end
end
local files = {}
for _ = 1, tonumber(count) do
local size, path, at = data:match("^@@ (%d+) ([^\n]+)\n()", pos)
if not size then return nil, "damaged (cut short?)" end
size = tonumber(size)
local content = data:sub(at, at + size - 1)
if #content ~= size then return nil, "damaged (cut short)" end
files[#files + 1] = {path = path, data = content}
pos = at + size + 1
end
if data:sub(pos, pos + 5) ~= "@@END\n" then return nil, "damaged (no end marker)" end
return files, version
end

function updates.run()
local source
for addr in component.list("filesystem") do
if addr ~= fsAddr and tryInvoke(addr, "exists", updates.DAT) then source = addr break end
end
if not source then
print("update: no disk has " .. updates.DAT .. " -- put the installer floppy (with the new files) in a drive")
return
end
print("update: reading " .. source:sub(1, 8) .. updates.DAT .. " (a floppy is slow -- about 10 s)...")
local data, err = updates.read(source, updates.DAT)
local files, version
if data then files, version = updates.parse(data) end
if not files then
print("update: " .. source:sub(1, 8) .. updates.DAT .. ": " .. tostring(err or version) .. " -- nothing was changed")
return
end
data = nil
local _, message = updates.install(files, version)
print("update: " .. message)
end






function updates.install(files, version)
local needed, staged, kernalBios = 4096, {}, nil
for _, f in ipairs(files) do
if not f.path:match("^/eeprom/") then needed = needed + #f.data end
end
local free = (tryInvoke(fsAddr, "spaceTotal") or 0) - (tryInvoke(fsAddr, "spaceUsed") or 0)
if free < needed then
return nil, string.format("the disk has %d KB free and the update needs %d KB -- nothing was changed",
free // 1024, needed // 1024)
end
local function abandon(why)
for _, path in ipairs(staged) do tryInvoke(fsAddr, "remove", path .. ".new") end
return nil, why .. " -- nothing was changed"
end
for _, f in ipairs(files) do
if f.path == "/eeprom/kernal.lua" then
kernalBios = f.data
elseif not f.path:match("^/eeprom/") then
local dir = f.path:match("^(.*)/[^/]+$")
if dir and dir ~= "" then tryInvoke(fsAddr, "makeDirectory", dir) end
local h, openErr = tryInvoke(fsAddr, "open", f.path .. ".new", "w")
if not h then return abandon("can't write " .. f.path .. ".new: " .. tostring(openErr)) end
staged[#staged + 1] = f.path
for i = 1, #f.data, updates.CHUNK do
if not tryInvoke(fsAddr, "write", h, f.data:sub(i, i + updates.CHUNK - 1)) then
tryInvoke(fsAddr, "close", h)
return abandon("writing " .. f.path .. " failed (disk full?)")
end
end
tryInvoke(fsAddr, "close", h)
if tryInvoke(fsAddr, "size", f.path .. ".new") ~= #f.data then return abandon("short write: " .. f.path) end
K.wait(0)
end
end

for _, path in ipairs(staged) do
if tryInvoke(fsAddr, "exists", path) then tryInvoke(fsAddr, "remove", path) end
if not tryInvoke(fsAddr, "rename", path .. ".new", path) then
return nil, "couldn't move " .. path .. " into place -- run update again"
end
end
local h = tryInvoke(fsAddr, "open", "/.muxos-version", "w")
if h then tryInvoke(fsAddr, "write", h, version .. "\n") tryInvoke(fsAddr, "close", h) end
local biosNote = ""
if kernalBios and eepromAddr and tryInvoke(eepromAddr, "get") ~= kernalBios then
tryInvoke(eepromAddr, "set", kernalBios)
if tryInvoke(eepromAddr, "get") == kernalBios then
tryInvoke(eepromAddr, "setLabel", "muxos kernal")
biosNote = "; the kernal BIOS was re-flashed"
else
biosNote = "; re-flashing the kernal BIOS FAILED (the old one is still there)"
end
end
return true, string.format("muxos %s installed (%d files)%s. Type `reboot` to start it, then restart the workers.",
version, #staged, biosNote)
end



function K.flagsCommand(S, args)
local name, value = args:match("^%s*(%S*)%s*(.-)%s*$")
if name == "" then
for _, f in ipairs(system.FLAGS) do
local v = system.flag(f.name)
print(string.format("%-22s = %-5s %s%s", f.name, tostring(v),
v == f.default and "" or "(default " .. tostring(f.default) .. ") ", "-- " .. f.help))
end
print("flags <name> <value> sets one (root only); kept in /etc/kernal.cfg")
return
end
if value == "" then
local known = false
for _, f in ipairs(system.FLAGS) do
if f.name == name then
known = true
print(f.name .. " = " .. tostring(system.flag(f.name)) .. " -- " .. f.help)
end
end
if not known then print("flags: no flag called " .. name) end
return
end
if S.user ~= "root" then print("flags: only root can change flags; log in as root") return end
local flag, err = system.setFlag(name, value)
if not flag then print("flags: " .. err) return end
print(name .. " = " .. tostring(system.flag(name)) .. (flag.reboot and "  (takes effect at the next boot)" or ""))
end





function K.runCommand(S, line)
if not S.user then return S.loginLine(line) end
if S.command(line) then return end
local word = line:match("^%s*(%S+)")


if line:find("[;|&<>]") and (word == "flags" or word == "useradd" or word == "userdel") then word = nil end
if line == "quit" or line == "shutdown" or line == "reboot" then
if not S.deny("reboot_requires_root", line) then shutdown(line == "reboot") end
elseif line == "update" then
if not S.deny("update_requires_root", "update") then updates.run() end
elseif word == "flags" then
K.flagsCommand(S, line:sub(6))
elseif line == "users" or line == "who" then
local on = {}
for _, other in ipairs(K.sessions) do
if other.user then
on[other.user] = (on[other.user] and on[other.user] .. ", " or "")
.. (other.kind == "local" and "console" or "terminal " .. tostring(other.address):sub(1, 8))
end
end
for _, name in ipairs(system.users()) do
if line == "users" or on[name] then
print(name .. "  " .. system.home(name) .. (on[name] and ("  (logged in: " .. on[name] .. ")") or ""))
end
end
elseif word == "useradd" or word == "userdel" then
local name = line:match("^%S+%s+(%S+)%s*$")
if not name then
print("usage: " .. word .. " <name>")
elseif not S.deny("useradd_requires_root", word) then
local ok, err
if word == "useradd" then
ok, err = system.addUser(name)
elseif K.loggedIn(name) then
err = name .. " is logged in"
else
ok, err = system.removeUser(name)
end
if ok then
print(word == "useradd" and ("added " .. name .. " (home " .. system.home(name) .. ")")
or ("removed " .. name .. " (their home " .. system.home(name) .. " is kept)"))
else
print(word .. ": " .. err)
end
end
elseif (word == "drain" or word == "undrain" or word == "migrate") and S.deny("drain_requires_root", word) then
return
elseif line == "discover" then
discover(1)
listNodes()
elseif line == "nodes" then
listNodes()
elseif line == "processes" then
printProcesses()
elseif line == "jobs" then
K.listJobs(S)
elseif word == "sysbus" then
K.sysbusCommand(S, line:match("^sysbus%s*(.-)%s*$"))
elseif word == "attach" then
K.attachJob(S, tonumber(line:match("^attach%s+(%d+)%s*$")))
elseif word == "persist" then
local id, onOff = line:match("^persist%s+(%d+)%s*(%a*)%s*$")
local job = id and jobs[tonumber(id)]
if not job or job.status ~= "running" or (job.user ~= S.user) then
print("usage: persist <job id> [on|off] -- one of your running processes")
else
local on = K.setPersistent(job, onOff ~= "off")
print("[" .. K.appRoot(job).id .. "] " .. (on and "keeps running after logout" or "ends at logout"))
end
elseif line:match("^ping%s") then
local node, countStr = line:match("^ping%s+(%S+)%s*(%S*)$")
if not node then
print("usage: ping <node> [count]")
else
pingReport(resolveNode(node), tonumber(countStr))
end
elseif line:match("^run%s") then
local result, err = submit(line:sub(5), nil)
if err then print("error: " .. err) else print(tostring(result)) end
elseif line:match("^runall%s") then
local code = line:sub(8)
for _, addr in ipairs(nodeOrder) do
if nodes[addr].down then goto continue end
local result, err = submit(code, nil, addr)
if err then print(addr .. ": error: " .. err)
else print(addr .. ": " .. tostring(result)) end
::continue::
end
elseif line:match("^spawn%s") then
local node, code = line:match("^spawn%s+(%S+)%s+(.*)$")
if not node then
print("usage: spawn <node> <lua code>")
else
local id, addrOrErr = dispatchJob(code, nil, resolveNode(node))
if not id then print("error: " .. addrOrErr) else print("spawned job [" .. id .. "] on " .. addrOrErr) end
end
elseif line:match("^pause%s") or line:match("^resume%s") or line:match("^kill%s") then
local verb, idStr = line:match("^(%a+)%s+(%d+)$")
if not verb then
print("usage: pause|resume|kill <job id>")
else
local job, user = jobs[tonumber(idStr)], S.user
local ok, err
if job and job.user ~= user and user ~= "root" and system.flag("kill_requires_owner") then
err = "job [" .. idStr .. "] is " .. tostring(job.user) .. "'s (flag kill_requires_owner)"
else
ok, err = controlJob(tonumber(idStr), verb:upper(), "killed by " .. user)
end
if ok then print(verb .. " sent to job [" .. idStr .. "]") else print("error: " .. err) end
end
elseif line:match("^migrate%s") then
local idStr, target = line:match("^migrate%s+(%d+)%s*(%S*)$")
if not idStr then
print("usage: migrate <job id> [node]")
else
local ok, result = migrateJob(tonumber(idStr), target ~= "" and resolveNode(target) or nil)
if ok then print("migrating job [" .. idStr .. "] to " .. result) else print("error: " .. result) end
end
elseif line:match("^drain%s") or line:match("^undrain%s") then
local verb, target = line:match("^(%a+)%s+(%S+)$")
local addr = target and resolveNode(target)
if not addr then
print("usage: drain|undrain <node>")
elseif verb == "undrain" then
if nodes[addr] then nodes[addr].draining = nil print(addr .. " takes new work again") else print("unknown node: " .. addr) end
else
local ok, moved, staying = drainNode(addr)
if ok then
print(string.format("draining %s: moving %d migratable job(s), %d will finish there", addr, moved, staying))
else
print("error: " .. moved)
end
end
elseif line == "bus" then
local addrs = {}
for addr in pairs(bus.components) do addrs[#addrs + 1] = addr end
table.sort(addrs, function(a, b)
local x, y = bus.components[a], bus.components[b]
if x.type ~= y.type then return x.type < y.type end
return a < b
end)
if #addrs == 0 then print("no components on the bus") end
for _, addr in ipairs(addrs) do
local c = bus.components[addr]
local where = c.node == selfAddr and "kernal" or c.node
if c.node ~= selfAddr and nodes[c.node] and nodes[c.node].down then where = where .. " (DOWN)" end
print(string.format("%-14s %s  on %s", c.type, addr, where))
end
elseif line:match("^components%s") then
printComponents(resolveNode(line:match("^components%s+(%S+)")))
elseif line:match("^call%s") then
local node, compAddr, method, rest = line:match("^call%s+(%S+)%s+(%S+)%s+(%S+)%s*(.*)$")
if not node then
print("usage: call <node> <component addr> <method> [args table]")
else
local args, parseOk = nil, true
if rest ~= "" then
args = deserialize(rest)
if args == nil then
print("could not parse args table: " .. rest)
parseOk = false
end
end
if parseOk then
local result, err = invoke(resolveNode(node), compAddr, method, args)
if err then print("error: " .. err) else print(serialize(result)) end
end
end
elseif line:match("%S") then
S.shellRun(line)
end
end



K.system, K.jobs, K.runningJobs = system, jobs, runningJobs
K.readFile, K.tryInvoke, K.fsAddr, K.loadSibling = readFile, tryInvoke, fsAddr, loadSibling
K.resolveProgram, K.readManifest, K.launchProgram, K.PROGRAM_PATH = resolveProgram, readManifest, launchProgram,
PROGRAM_PATH
K.MUXOS_VERSION, K.selfAddr, K.fullscreen, K.controlJob = MUXOS_VERSION, selfAddr, fullscreen, controlJob
K.lineedit = loadSibling("lineedit.lua")()
K.win = loadSibling("windows.lua")(K)
K.sysbus = loadSibling("sysbus.lua")(K, {send = send, selfAddr = selfAddr})
K.sessionChunk = loadSibling("session.lua")
K.nextSession = 0

function K.deliverEvent(job, event)
send({type = "EVENT", from = selfAddr, to = job.node, jobId = job.id, event = event})
end


function K.liveJob(id)
local job = jobs[id]
if job and job.status == "running" and nodes[job.node] and not nodes[job.node].down then return job end
end



function K.closeWindow(id)
local rec = K.win.get(id)
if not rec then return false end
K.win.close(rec)
local job = rec.owner and K.liveJob(rec.owner)
if job then controlJob(job.id, "KILL", "killed (window closed)") end
return true
end

function K.windowGeometry(id, x, y, width, height)
local rec = K.win.get(id)
if rec then K.win.moved(rec, x, y, width, height) end
end

function K.userWindows(user) return K.win.ofUser(user) end








function K.appRoot(job)
for _ = 1, 64 do
local parent = job.parent and jobs[job.parent]
if not parent then break end
job = parent
end
return job
end

function K.isPersistent(job)
return K.appRoot(job).persistent == true
end


function K.setPersistent(job, on)
local root = K.appRoot(job)
root.persistent = on and true or nil
for _, rec in pairs(K.win.byId) do
local owner = rec.owner and jobs[rec.owner]
if owner and K.appRoot(owner) == root then K.win.persistChanged(rec, on and true or false) end
end
return on and true or false
end


function K.togglePersist(id, S)
local rec = K.win.get(id)
local job = rec and rec.user == S.user and K.liveJob(rec.owner)
if job then K.setPersistent(job, not K.isPersistent(job)) end
end



function K.rebind(job, S, force)
local root = K.appRoot(job)
if K.sessionOf(root) and not force then return end
for id in pairs(runningJobs) do
local j = jobs[id]
if K.appRoot(j) == root then j.session, j.login = S.id, S.login end
end
end


function K.attachWindow(id, S)
local rec = K.win.get(id)
if not rec or rec.user ~= S.user then return nil, "no such window of yours" end
local ok, err = K.win.attach(rec, S)
local owner = ok and K.liveJob(rec.owner)
if owner then K.rebind(owner, S) end
return ok, err
end



function K.attachJob(S, id)
local job = jobs[id]
if not job or job.status ~= "running" or job.user ~= S.user then
return print("attach: no running process " .. tostring(id) .. " of yours")
end
local root = K.appRoot(job)
K.rebind(root, S, true)
local moved = 0
for _, rec in pairs(K.win.byId) do
local owner = rec.owner and jobs[rec.owner]
if owner and K.appRoot(owner) == root and rec.session ~= S.id and K.win.attach(rec, S) then moved = moved + 1 end
end
for _, jid in ipairs(orderedJobIds()) do
local j = jobs[jid]
if j.away and K.appRoot(j) == root then
print("[" .. jid .. "] while you were away:")
S.write(j.away:sub(-1) == "\n" and j.away or j.away .. "\n")
j.away = nil
end
end
print("[" .. root.id .. "] " .. tostring(root.path or "job") .. " attached here (" .. moved .. " window"
.. (moved == 1 and "" or "s") .. " brought over)")
end


function K.listJobs(S)
local any = false
for _, id in ipairs(orderedJobIds()) do
local job = jobs[id]
if job.status == "running" and job.user == S.user and not job.parent then
local where = K.sessionOf(job)
local children = 0
for cid in pairs(runningJobs) do
if cid ~= id and K.appRoot(jobs[cid]) == job then children = children + 1 end
end
print(string.format("[%d] %s%s -- %s%s%s", id, tostring(job.path or job.codePreview or "job"),
children > 0 and (" (+" .. children .. " child" .. (children == 1 and "" or "ren") .. ")") or "",
where == S and "here" or where and (where.kind == "local" and "at the console" or "at terminal "
.. tostring(where.address):sub(1, 8)) or "detached",
job.persistent and ", kept after logout" or "", job.away and ", has output" or ""))
any = true
end
end
if not any then print("no processes of yours running") end
end






function K.where(S)
return S.kind == "local" and "console" or "terminal " .. tostring(S.address):sub(1, 8)
end


function K.loginStarted(S)
K.sysbus.emit("muxos.login", S.user, K.where(S))
end

function K.endLogin(S)
if S.user then K.sysbus.emit("muxos.logout", S.user, K.where(S)) end
local ending = system.flag("logout_ends_jobs")
for id in pairs(runningJobs) do
local job = jobs[id]
if job.login == S.login and ending and not job.parent and not K.isPersistent(job) then
job.loggedOut = true
controlJob(id, "KILL", "killed (logged out)")
end
end
K.win.sessionEnded(S)
end


function K.newCompositor(g)
return loadSibling("compositor.lua")(loadSibling, {gpu = g, nextId = function()
K.windowIds = K.windowIds + 1
return K.windowIds
end})
end

function K.nextLogin()
K.logins = K.logins + 1
return K.logins
end


function K.loggedIn(name)
for _, S in ipairs(K.sessions) do
if S.user == name then return S end
end
end



do
local ok, factory = pcall(loadSibling, "shell.lua")
K.shellFactory = ok and factory or nil
K.shellError = not ok and tostring(factory) or nil
end








function K.apps()
local apps, seen = {}, {}
for _, dir in ipairs(PROGRAM_PATH) do
local names = tryInvoke(fsAddr, "list", dir)
if type(names) == "table" then
table.sort(names)
for _, n in ipairs(names) do
local base = n:match("^(.-)%.mxe$") or n:match("^(.-)%.lua$")
local path = base and not seen[base] and resolveProgram(base)
if path then
seen[base] = true
local art, color
local source = path:match("%.mxe$") and readFile(path)
local manifest = source and readManifest(source)
if manifest and type(manifest.icon) == "table" then art, color = manifest.icon, manifest.icon_color end
if not art then
local text = readFile((path:gsub("%.[^./]*$", "")) .. ".icon")
if text then
art = {}
for line in (text .. "\n"):gmatch("([^\n]*)\n") do
local hex = #art == 0 and not color and line:match("^#(%x%x%x%x%x%x)%s*$")
if hex then color = tonumber(hex, 16) elseif #art < 4 then art[#art + 1] = line end
end
while #art > 0 and art[#art] == "" do art[#art] = nil end
end
end
apps[#apps + 1] = {name = base, path = path, art = art, color = color}
end
end
end
end
return apps
end


function K.fileSize(path)
if not tryInvoke(fsAddr, "exists", path) or tryInvoke(fsAddr, "isDirectory", path) then return nil end
return tryInvoke(fsAddr, "size", path) or 0
end


function K.writeFile(path, data)
if data == nil then return tryInvoke(fsAddr, "remove", path) end
local dir = path:match("^(.*)/[^/]*$")
if dir and dir ~= "" then tryInvoke(fsAddr, "makeDirectory", dir) end
local h, err = tryInvoke(fsAddr, "open", path, "w")
if not h then return nil, err end
tryInvoke(fsAddr, "write", h, data)
tryInvoke(fsAddr, "close", h)
return true
end



K.MUXOS_COMMANDS = {}
for name in ("discover nodes processes ping run runall spawn window windows console comp focus bitdemo "
.. "bus components call pause resume kill migrate drain undrain update reboot quit exit wallpaper "
.. "shutdown logout flags users useradd userdel who jobs persist attach sysbus"):gmatch("%S+") do
K.MUXOS_COMMANDS[name] = true
end





function K.runForeground(S, id)
S.beginForeground(id)
while jobs[id] and jobs[id].status == "running" do K.wait(0.5) end
S.endForeground()
local job = jobs[id]
if job and job.status ~= "done" then S.print(job.status .. ": " .. tostring(job.error)) end
end




function K.newShell(S, user)
tryInvoke(fsAddr, "makeDirectory", system.home(user))
if not K.shellFactory then return nil end
return K.shellFactory({
invoke = tryInvoke, root = fsAddr, tmp = computer.tmpAddress(), list = component.list,
write = S.write, width = S.consoleWidth, clear = S.clearConsole,
sleep = function(seconds)
local deadline = computer.uptime() + seconds
while computer.uptime() < deadline do K.wait(deadline - computer.uptime()) end
end,
help = function() K.help() end,
info = {version = MUXOS_VERSION, address = selfAddr or computer.address(), uptime = computer.uptime,
memory = function() return computer.freeMemory(), computer.totalMemory() end},
user = user, home = system.home(user),



external = function(argv, background)

local keep = argv[1] == "nohup"
if keep then
table.remove(argv, 1)
if not argv[1] then S.print("usage: nohup <program> [args]") return 2 end
end
if K.MUXOS_COMMANDS[argv[1]] and not keep then
K.runCommand(S, table.concat(argv, " "))
return 0
end
local path = resolveProgram(argv[1])
if not path then
S.print("sh: " .. argv[1] .. ": command not found")
return 127
end
local id, addrOrErr = launchProgram(path, {table.unpack(argv, 2)})
if id and keep then K.setPersistent(jobs[id], true) end
if not id then
S.print("error: " .. addrOrErr)
return 1
elseif background or path:match("%.lua$") then
S.print("[" .. id .. "] " .. path .. " started on " .. addrOrErr .. (keep and " (kept after logout)" or ""))
return 0
end
K.runForeground(S, id)
return jobs[id] and jobs[id].status == "done" and 0 or 1
end,
})
end


function K.newSession(opts)
opts.id = K.nextSession + 1
return K.addSession(K.sessionChunk(K, opts))
end


function K.addSession(S)
K.nextSession = K.nextSession + 1
S.id = K.nextSession
K.sessions[#K.sessions + 1] = S
K.byId[S.id] = S
return S
end


function K.endSession(S)
if not K.byId[S.id] then return end
if S.user then K.inSession(S, S.logout) end
for i, other in ipairs(K.sessions) do
if other == S then table.remove(K.sessions, i) break end
end
K.byId[S.id] = nil
if K.console == S then K.console = nil end
end


function K.help()
print("muxos commands:")
print("  discover | nodes | ping <node> [count] | logout | shutdown | reboot")
print("  users | who | useradd <name> | userdel <name> | flags [<name> [<value>]] -- users and kernal flags")
print("  update -- install a new muxos from the installer floppy's muxos-installer.dat")
print("  wallpaper <file.ppm> | wallpaper none -- the desktop's background image")
print("  run <lua code> | runall <lua code> | processes | pause|resume|kill <job id>")
print("  jobs | nohup <command> | persist <job id> [on|off] | attach <job id> -- what runs after logout")
print("  sysbus | sysbus call <name> <method> [args] -- the system bus: programs' named services")
print("  migrate <job id> [node] | drain|undrain <node>")
print("  spawn <node> <lua code>")
print("  window <title> <x> <y> <width> <height> <lua code drawing into `gpu`> | windows")
print("  console <width> <height> [x y] -- resize/move the console window")
print("  comp -- back to the desktop from console mode (hold Ctrl+Alt+C to enter it; a press exits fullscreen); PgUp/PgDn or the wheel scroll")
print("  focus <window id> -- gives a window the keyboard (touching it does too)")
print("  bitdemo <halfblock|braille> <x> <y> -- draws a test pattern as a bit window")
print("  bus (every component in the cluster) | components <node> | call <node> <component addr> <method> [args table]")
print("(<node> is either a [n] index from 'nodes' or a full node address)")
end






function K.sysbusCommand(S, args)
if args == "" then
for _, t in ipairs(K.sysbus.list()) do
print(string.format("%-24s %s", t.name, t.kernal and "(kernal)" or ("process " .. tostring(t.job)
.. " (" .. tostring(t.user) .. ")")))
end
return
end
local words = {}
for w in args:gmatch("%S+") do words[#words + 1] = w end
if words[1] ~= "call" or not words[3] then
return print("usage: sysbus | sysbus call <name> <method> [args]")
end
local callArgs = {n = #words - 3}
for i = 4, #words do
local w = words[i]
if w == "true" or w == "false" then callArgs[i - 3] = w == "true"
elseif w ~= "nil" then callArgs[i - 3] = tonumber(w) or w end
end
local ok, results = K.sysbus.consoleCall(S, words[2], words[3], callArgs)
if not ok then return print("error: " .. tostring(results)) end
local out = {}
for i = 1, results.n or #results do
local v = results[i]
out[i] = type(v) == "table" and serialize(v) or tostring(v)
end
print(#out > 0 and table.concat(out, "\t") or "(no results)")
end

local function sysbusUser(ctx, flagName, doing)
local ok, why = system.allowed(ctx.user, flagName, doing)
if not ok then error(why, 0) end
end

K.sysbus.provide("muxos.system", {
version = function() return MUXOS_VERSION end,
uptime = function() return computer.uptime() end,
users = function() return system.users() end,

who = function()
local list = {}
for _, S in ipairs(K.sessions) do
if S.user then list[#list + 1] = {user = S.user, where = K.where(S)} end
end
return list
end,

nodes = function()
local list = {}
for _, addr in ipairs(nodeOrder) do
local n = nodes[addr]
list[#list + 1] = {address = addr, up = not n.down, load = n.load, free = n.free, running = n.running or 0}
end
return list
end,


reboot = function(ctx)
sysbusUser(ctx, "reboot_requires_root", "reboot")
K.sysbus.after(1, function() shutdown(true) end)
return true
end,
})


K.sysbus.provide("muxos.update", {

version = function()
local installed = readFile("/.muxos-version")
return {running = MUXOS_VERSION, installed = installed and installed:match("^%s*(.-)%s*$")}
end,

files = function()
local list = {}
for _, name in ipairs(tryInvoke(fsAddr, "list", "/") or {}) do
if name:match("%.lua$") then list[#list + 1] = {path = "/" .. name, size = tryInvoke(fsAddr, "size", "/" .. name)} end
end
table.sort(list, function(a, b) return a.path < b.path end)
return list
end,




install = function(ctx, files, version)
sysbusUser(ctx, "update_requires_root", "update")
if type(files) ~= "table" or #files == 0 then error("install(files, version): files is a list of {path, data}", 0) end
for _, f in ipairs(files) do
if type(f) ~= "table" or type(f.path) ~= "string" or type(f.data) ~= "string"
or f.path:sub(1, 1) ~= "/" or f.path:find("..", 1, true) then
error("install: bad file entry " .. tostring(type(f) == "table" and f.path or f), 0)
end
if f.path:match("%.lua$") then
local ok, err = load(f.data, "=" .. f.path, "t", {})
if not ok then error("install: " .. tostring(err) .. " -- nothing was changed", 0) end
end
end
local ok, message = updates.install(files, tostring(version or "opm"))
if not ok then error(message, 0) end
return message
end,
})



if gpu and screenAddr then K.console = K.newSession({gpu = gpu, kind = "local"}) end
K.terminals = loadSibling("terminals.lua")(K, {modem = modem, send = send})
print("muxos kernal -- " .. selfAddr)
K.help()
if K.shellFactory then
print("shell: ls cd cat cp mv rm mkdir grep ... with | > >> < ; && || -- type 'help'")
else
print("no shell (" .. tostring(K.shellError) .. ") -- run `update` with the installer floppy in")
end
for _, problem in ipairs(system.loadFlags()) do print("flags: " .. problem) end
discover(1)
listNodes()
if K.console then
if system.flag("login_required") then
K.inSession(K.console, K.console.showLogin)
else
K.inSession(K.console, K.console.startSession, "root")
end
end

while true do
tick(0.05)
local busOk, busErr = pcall(K.sysbus.resume)
if not busOk then print("system bus error (continuing): " .. tostring(busErr)) end
for _, S in ipairs(K.sessions) do
local ok, err = pcall(S.resume)
if not ok then print("session error (continuing): " .. tostring(err)) end
end
end

