--[[mxe
muxos = "0.1.2"
name = "demo"
version = "1.0"
description = "muxos demo: threads, child processes on the workers, color and braille graphics"
author = "muxos"
libraries = {"thread"}
icon = {
  "  .:::.  ",
  " :#ooo#: ",
  " :#ooo#: ",
  "  ':::'  ",
}
icon_color = {0xFF44FF, 0x44FFFF, 0x44FF44, 0xFFFF44}
]]
-- The muxos demo -- a test program for the things muxos does that OpenOS
-- doesn't:
--   * threads within one process (the `thread` library): four run at
--     once, each waiting on its own timers and kernal calls;
--   * child processes the scheduler spreads over the workers: a
--     Mandelbrot image is split into strips, each computed by a child;
--   * windows of colored half-block "bit" graphics and braille graphics
--     (kernal/bitmap.lua), redrawn live, and a text status window.
-- Usage: demo [strips]   (default 4).  Press q in one of its windows to end.
local thread = require("thread")

local STRIPS = math.max(1, math.min(12, math.floor(tonumber((...)) or 4)))
local IMG_W, IMG_H = 48, 24   -- half-block pixels: 48x12 cells
local PLOT_W, PLOT_H = 40, 24 -- braille pixels: 20x6 cells
local ITERATIONS = 40

local running = true
local state = {phase = "starting", frames = 0, strips = {}, workers = {}, started = computer.uptime()}

-- Each strip's child process: the escape-time counts for its rows. It
-- runs on whichever worker the scheduler picks, with the native API, so
-- it reports which node it ran on.
local STRIP_CODE = [[
local a = args
local rows = {}
for py = a.y0, a.y1 do
  local row = {}
  local ci = -1.2 + (py - 1) * 2.4 / a.h
  for px = 1, a.w do
    local cr = -2.2 + (px - 1) * 3.0 / a.w
    local zr, zi, n = 0, 0, 0
    while n < a.iter and zr * zr + zi * zi < 4 do
      zr, zi = zr * zr - zi * zi + cr, 2 * zr * zi + ci
      n = n + 1
    end
    row[px] = n
  end
  rows[#rows + 1] = row
  yield()
end
return {y0 = a.y0, rows = rows, node = computer.address()}
]]

-- A hue (0..1) as a 24-bit color.
local function hue(h)
  h = (h % 1) * 6
  local i = math.floor(h)
  local f = h - i
  local q, t = math.floor(255 * (1 - f)), math.floor(255 * f)
  local rgb = ({{255, t, 0}, {q, 255, 0}, {0, 255, t}, {0, q, 255}, {t, 0, 255}, {255, 0, q}})[i + 1]
  return (rgb[1] << 16) | (rgb[2] << 8) | rgb[3]
end

local function blank(h)
  local pixels = {}
  for y = 1, h do pixels[y] = {} end
  return pixels
end

local function window(options)
  local win, err = gmuxapi.create_window(options)
  if not win then error("can't create a window: " .. tostring(err)) end
  return win.id
end

local imageWin = window({title = "demo: color (half-block)", x = 2, y = 2, width = IMG_W, height = IMG_H,
  pixels = blank(IMG_H), mode = "halfblock", bg = 0x000000})
local plotWin = window({title = "demo: braille", x = 52, y = 2, width = PLOT_W, height = PLOT_H,
  pixels = blank(PLOT_H), mode = "braille", bg = 0x000000})
local statusWin = window({title = "demo: threads", x = 52, y = 10, width = 30, height = STRIPS + 6,
  code = "gpu.fill(1, 1, 30, 30, ' ')"})

-- --- Thread 1: the image, computed by child processes, then animated ---

local counts = {}
local function drawImage(shift)
  local pixels = {}
  for y = 1, IMG_H do
    local row, src = {}, counts[y]
    if src then
      for x = 1, IMG_W do
        local n = src[x]
        if n and n < ITERATIONS then row[x] = hue(n / 16 + shift) end
      end
    end
    pixels[y] = row
  end
  gmuxapi.draw_window(imageWin, {pixels = pixels, mode = "halfblock", width = IMG_W, height = IMG_H, bg = 0x000000})
end

local imageThread = thread.create(function()
  -- The strips, queued: a job tree may run as many children at once as
  -- there are live workers (muxos's fan-out cap), so the next strip
  -- starts whenever one finishes.
  local per = math.ceil(IMG_H / STRIPS)
  local queue, children = {}, {}
  for i = 1, STRIPS do
    local y0, y1 = (i - 1) * per + 1, math.min(IMG_H, i * per)
    if y0 <= y1 then
      queue[#queue + 1] = i
      state.strips[i] = {rows = y0 .. "-" .. y1, status = "queued", node = "", y0 = y0, y1 = y1}
    end
  end
  local total, finished = #queue, 0
  state.phase = "computing on the workers"
  while finished < total and running do
    -- Start what the cap allows.
    while #queue > 0 do
      local s = state.strips[queue[1]]
      local child, err = gmuxapi.create_headless_process({code = STRIP_CODE, name = "demo-strip",
        orphan_policy = "kill", args = {y0 = s.y0, y1 = s.y1, w = IMG_W, h = IMG_H, iter = ITERATIONS}})
      if not child then
        if not tostring(err):find("fan-out cap", 1, true) then error(err) end
        break -- wait for one to finish
      end
      s.status, s.node, s.id = "running", child.process.node, child.process.id
      children[#children + 1] = queue[1]
      table.remove(queue, 1)
    end
    sleep(0.2)
    for k = #children, 1, -1 do
      local s = state.strips[children[k]]
      local job = gmuxapi.get_process(s.id)
      if job and job.status ~= "running" and job.status ~= "queued" then
        table.remove(children, k)
        finished = finished + 1
        if job.status == "done" and type(job.result) == "table" then
          s.status, s.node = "done", job.result.node
          state.workers[job.result.node] = true
          for r, row in ipairs(job.result.rows) do counts[job.result.y0 + r - 1] = row end
          drawImage(0) -- each strip shows as it arrives
        else
          s.status = tostring(job.status)
        end
      end
    end
  end
  local nodes = 0
  for _ in pairs(state.workers) do nodes = nodes + 1 end
  print(string.format("demo: image computed by %d child processes on %d worker(s) in %.1f s",
    total, nodes, computer.uptime() - state.started))
  state.phase = "cycling colors"
  local shift = 0
  while running do
    shift = shift + 0.05
    drawImage(shift)
    state.frames = state.frames + 1
    sleep(0.5)
  end
end)

-- --- Thread 2: braille graphics -- a Lissajous figure and a wave ---

local plotThread = thread.create(function()
  local t = 0
  while running do
    local pixels = {}
    for y = 1, PLOT_H do pixels[y] = {} end
    for k = 0, 200 do
      local a = k / 200 * 2 * math.pi
      local x = math.floor(PLOT_W / 2 + (PLOT_W / 2 - 2) * math.sin(3 * a + t) + 0.5)
      local y = math.floor((PLOT_H - 6) / 2 + ((PLOT_H - 6) / 2 - 1) * math.sin(2 * a) + 1.5)
      if pixels[y] and x >= 1 and x <= PLOT_W then pixels[y][x] = 0x44FF44 end
    end
    for x = 1, PLOT_W do
      local y = math.floor(PLOT_H - 2.5 + 2 * math.sin(x / 4 + t * 2) + 0.5)
      if pixels[y] then pixels[y][x] = 0x44FFFF end
    end
    gmuxapi.draw_window(plotWin, {pixels = pixels, mode = "braille", width = PLOT_W, height = PLOT_H, bg = 0x000000})
    t = t + 0.3
    sleep(0.4)
  end
end)

-- --- Thread 3: the status window ---

local STATUS_CODE = [[
gpu.setBackground(0x000000)
gpu.fill(1, 1, 30, #args, " ")
for i, line in ipairs(args) do
  gpu.setForeground(i == 1 and 0x44FFFF or 0xFFFFFF)
  gpu.set(1, i, line)
end
]]

local statusThread = thread.create(function()
  while running do
    local lines = {"threads: 4  q quits", state.phase:sub(1, 30),
      string.format("frames %d  up %.0fs", state.frames, computer.uptime() - state.started), "strips:"}
    for i, s in ipairs(state.strips) do
      lines[#lines + 1] = string.format(" %d rows %-5s %-7s %s", i, s.rows, s.status, tostring(s.node):sub(1, 8))
    end
    gmuxapi.draw_window(statusWin, {code = STATUS_CODE, args = lines})
    sleep(1)
  end
end)

-- --- The main thread: waits for q, while the others run ---

print("demo: started -- " .. STRIPS .. " strips; press q in a demo window to end")
while running do
  local e = gmuxapi.pull_event(1)
  if e and e[1] == "key_down" and (e[2] == 113 or e[2] == 81) then running = false end
end
for _, t in ipairs({imageThread, plotThread, statusThread}) do t:join(5) end
print("demo: done")
return "demo finished"
